+        // Tessera start - find viewer changes off the region thread
+        // Read-only version of moonrise$tick, runs off the region thread. Only this entity's fields are written.
+        public boolean hasViewerChanges(final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.@Nullable TrackedChunk chunk, final Set<ServerPlayer> localPlayers) {
+            if (chunk == null) {
+                return true;
+            }
+
+            final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> players = chunk.getPlayers(ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.VIEW_DISTANCE);
+
+            if (players == null) {
+                return true;
+            }
+
+            final ServerPlayer[] playersRaw = players.getRawDataUnchecked();
+
+            for (int i = 0, len = players.size(); i < len; ++i) {
+                final ServerPlayer player = playersRaw[i];
+                if (player != this.entity
+                    && (localPlayers.contains(player) && this.isVisibleTo(player)) != this.seenBy.contains(player.connection)) {
+                    return true;
+                }
+            }
+
+            final long currChunkUpdate = chunk.getUpdateCount();
+            if (this.lastChunkUpdate != currChunkUpdate || this.lastTrackedChunk != chunk) {
+                for (final ServerPlayerConnection conn : this.seenBy) {
+                    if (!players.contains(conn.getPlayer())) {
+                        return true;
+                    }
+                }
+                this.lastChunkUpdate = currChunkUpdate;
+                this.lastTrackedChunk = chunk;
+            }
+
+            return false;
+        }
+        // Tessera end - find viewer changes off the region thread
+
