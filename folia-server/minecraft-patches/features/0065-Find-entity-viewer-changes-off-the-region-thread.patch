Subject: [PATCH] Find entity viewer changes off the region thread

With every player in one region the tracker checks every player against every entity each tick, and almost every check changes nothing. With performance.async-entity-tracker the check runs read-only on a pool while the region thread waits, so the state it reads does not change. Entities with a change run the usual update on the region thread, so adding and removing viewers, events and packets stay there. Regions with fewer than 10000 entity and player pairs do not use the pool.

diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 71c700ef3bb42dd675c33051994fe12f27e57ef1..a37840b04e1eae4301cdb67a208c61cb7238282c 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1110,6 +1110,31 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     }
     // Tessera end - update the viewers of stationary entities less often
 
+    // Tessera start - find viewer changes off the region thread
+    private static final int ASYNC_TRACKER_MIN_PAIRS = 10_000;
+    private static final int ASYNC_TRACKER_BATCH = 32;
+
+    // the region thread waits for the pool, so nothing the workers read changes under them
+    private boolean @Nullable [] findViewerChanges(final Entity[] entities, final int count, final ca.spottedleaf.moonrise.common.misc.NearbyPlayers nearbyPlayers, final List<ServerPlayer> players) {
+        if (!io.papermc.paper.threadedregions.TesseraCompat.asyncEntityTracker() || (long)count * players.size() < ASYNC_TRACKER_MIN_PAIRS) {
+            return null;
+        }
+        final Set<ServerPlayer> localPlayers = new it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<>(players);
+        final boolean[] changed = new boolean[count];
+        io.papermc.paper.threadedregions.TesseraTrackerPool.forEach(count, ASYNC_TRACKER_BATCH, i -> {
+            try {
+                final Entity entity = entities[i];
+                final ChunkMap.TrackedEntity tracker = ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity();
+                changed[i] = tracker != null && tracker.hasViewerChanges(nearbyPlayers.getChunk(entity.chunkPosition()), localPlayers);
+            } catch (final RuntimeException ex) {
+                changed[i] = true; // the region thread does the full update
+                io.papermc.paper.threadedregions.TesseraTrackerPool.reportFailure(ex);
+            }
+        });
+        return changed;
+    }
+    // Tessera end - find viewer changes off the region thread
+
