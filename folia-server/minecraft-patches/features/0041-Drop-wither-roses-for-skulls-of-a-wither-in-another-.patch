+++ b/net/minecraft/world/entity/projectile/hurtingprojectile/WitherSkull.java
@@ -72,7 +72,16 @@ public class WitherSkull extends AbstractHurtingProjectile {
                     }
                 }
             } else {
+                // Tessera start - wither rose for skulls of a wither in another region - mark before the hit, it may kill
+                LivingEntity witherVictim = var8 instanceof LivingEntity victim
+                    && this.getOwnerRaw() instanceof net.minecraft.world.entity.boss.wither.WitherBoss wither && !wither.isRemoved() ? victim : null;
+                int previousWitherHit = witherVictim == null ? 0 : witherVictim.tesseraWitherSkullHitTimestamp;
+                if (witherVictim != null) {
+                    witherVictim.tesseraWitherSkullHitTimestamp = witherVictim.tickCount;
+                }
+                // Tessera end - wither rose for skulls of a wither in another region
                 wasHurt = var8.hurtServer(serverLevel, this.damageSources().magic().eventEntityDamager(this), 5.0F); // Paper - Fire EntityDamageByEntityEvent for unowned wither skulls // Paper - fix DamageSource API
+                if (witherVictim != null && !wasHurt) witherVictim.tesseraWitherSkullHitTimestamp = previousWitherHit; // Tessera - wither rose for skulls of a wither in another region
             }
 
             if (wasHurt && var8 instanceof LivingEntity livingEntity) {
