             int yPosition = level.getHeight(SpawnPlacements.getHeightmapType(EntityTypes.WANDERING_TRADER), xPosition, zPosition);
             BlockPos spawnPos = new BlockPos(xPosition, yPosition, zPosition);
             if (wanderingTraderSpawnType.isSpawnPositionOk(level, spawnPos, EntityTypes.WANDERING_TRADER)) {
diff --git a/net/minecraft/world/level/saveddata/WanderingTraderData.java b/net/minecraft/world/level/saveddata/WanderingTraderData.java
index 60cc79dff0d2e3b808e881e673bb8133b49a832f..c7f35725a4cdfd2ecc455581cc162e0e72925d4f 100644
--- a/net/minecraft/world/level/saveddata/WanderingTraderData.java
+++ b/net/minecraft/world/level/saveddata/WanderingTraderData.java
@@ -29,6 +29,14 @@ public class WanderingTraderData extends SavedData {
         this.spawnChance = spawnChance;
     }
 
+    // Tessera start - keep the wandering trader timer
+    public WanderingTraderData tesseraCopy() {
+        final WanderingTraderData copy = new WanderingTraderData(this.spawnDelay, this.spawnChance);
+        copy.tickDelay = this.tickDelay;
+        return copy;
+    }
+    // Tessera end - keep the wandering trader timer
+
     public int spawnDelay() {
