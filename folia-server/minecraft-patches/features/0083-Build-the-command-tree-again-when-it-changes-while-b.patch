From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Tue, 3 Nov 2026 09:29:02 +0300
Subject: [PATCH] Build the command tree again when it changes while being
 copied

Plugins in compatibility mode (Skript reloading scripts) and plugins
writing to the dispatcher change the command tree on the global thread,
while region threads copy it and the async command builder pool walks
it. The walk failed with a ConcurrentModificationException and the
player kept the old tree. Send the commands again next tick instead.

diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index 3f3da9c1796bd22bad7019fe7da1b1f798315d3e..79d1f9f44c0d8a7a736962397ec97aa99c350d67 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -499,10 +499,28 @@ public class Commands {
         // Paper start - Perf: Async command map building
         // Copy root node to avoid concurrent modification during building
         final RootCommandNode<CommandSourceStack> rootNode = new RootCommandNode<>();
+        // Tessera start - the command tree can change on another thread while it is copied
+        try {
         this.dispatcher.getRoot().getChildren().forEach(rootNode::addChild);
+        } catch (final java.util.ConcurrentModificationException ex) {
+            this.resendCommandsLater(player);
+            return;
+        }
+        // Tessera end - the command tree can change on another thread while it is copied
         COMMAND_SENDING_POOL.execute(() -> this.sendAsync(player, rootNode));
     }
 
+    // Tessera start - the command tree can change on another thread while it is copied
+    // Plugins in compatibility mode (Skript reloading scripts) and plugins writing to the dispatcher change the tree on
+    // the global thread, while region threads and the builder pool walk it. Build it again next tick from a fresh copy;
+    // the player would otherwise keep the old tree.
+    private void resendCommandsLater(final ServerPlayer player) {
+        player.getBukkitEntity().taskScheduler.schedule((ServerPlayer updatedPlayer) -> {
+            this.sendCommands(updatedPlayer);
+        }, null, 1L);
+    }
+    // Tessera end - the command tree can change on another thread while it is copied
+
     // Fixed pool, but with discard policy
     public static final java.util.concurrent.ExecutorService COMMAND_SENDING_POOL = new java.util.concurrent.ThreadPoolExecutor(
         2, 2, 0, java.util.concurrent.TimeUnit.MILLISECONDS,
@@ -519,8 +537,15 @@ public class Commands {
         Map<CommandNode<CommandSourceStack>, CommandNode<CommandSourceStack>> playerCommands = new HashMap<>();
         RootCommandNode<CommandSourceStack> root = new RootCommandNode<>();
         // Paper start - Perf: Async command map building; pass copy of root
-        playerCommands.put(dispatcherRoot, root);
+        // Tessera start - the command tree can change on another thread while it is copied
+        try {
+        playerCommands.put(dispatcherRoot, root); // hashCode walks the whole tree
         fillUsableCommands(dispatcherRoot, root, player.createCommandSourceStack(), playerCommands);
+        } catch (final java.util.ConcurrentModificationException ex) {
+            this.resendCommandsLater(player);
+            return;
+        }
+        // Tessera end - the command tree can change on another thread while it is copied
         // Paper end - Perf: Async command map building; pass copy of root
 
         java.util.Collection<String> bukkit = new java.util.LinkedHashSet<>();
