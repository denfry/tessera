From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Fri, 30 Oct 2026 13:27:16 +0300
Subject: [PATCH] Add a merge radius option for regions

The regionizer merges regions whose sections are within one section of
each other, and the only way to change how close regions may get was
the grid exponent, which also changes the section size. Servers with
farms or portals spread over nearby regions could not keep them on one
thread without resizing every section.

threaded-regions.merge-radius sets the radius in sections. It defaults
to 1, the previous value, and only keeps regions further apart, so the
minimum distance between regions does not shrink.

diff --git a/io/papermc/paper/threadedregions/TickRegions.java b/io/papermc/paper/threadedregions/TickRegions.java
index ac44f1e797eb47229b5cdf4f7752094b39e650f1..2f7a7bbacba09b233d9a3e2d9cd1907998dc564d 100644
--- a/io/papermc/paper/threadedregions/TickRegions.java
+++ b/io/papermc/paper/threadedregions/TickRegions.java
@@ -33,6 +33,15 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
         return regionShift;
     }
 
+    // Tessera start - configurable merge radius
+    private static final int MAX_MERGE_RADIUS = 16;
+    private static int mergeRadius = 1;
+
+    public static int getRegionMergeRadius() {
+        return mergeRadius;
+    }
+    // Tessera end - configurable merge radius
+
     private static boolean initialised;
     private static boolean started;
     private static TickRegionScheduler scheduler;
@@ -70,6 +79,7 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
         gridExponent = Math.max(0, gridExponent);
         gridExponent = Math.min(31, gridExponent);
         regionShift = gridExponent;
+        mergeRadius = Math.clamp(config.mergeRadius, 1, MAX_MERGE_RADIUS); // Tessera - configurable merge radius
         scheduler = new TickRegionScheduler(config.scheduler, tickThreads);
         LOGGER.info("Initialised " + config.scheduler + " Folia scheduler with initial " + tickThreads + " target thread(s)");
     }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 59832e44dc94fe1ec39f218717f7e09405f2f8dc..9ae85d7f5d506cf4a0e8d216de7e4dc885b00c27 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -715,7 +715,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                 (int)Math.max(1L, (8L * 16L * 16L) / (1L << (2 * (io.papermc.paper.threadedregions.TickRegions.getRegionChunkShift())))),
                 (1.0 / 6.0),
                 Math.max(1, 8 / (1 << io.papermc.paper.threadedregions.TickRegions.getRegionChunkShift())),
-                1,
+                io.papermc.paper.threadedregions.TickRegions.getRegionMergeRadius(), // Tessera - configurable merge radius
                 io.papermc.paper.threadedregions.TickRegions.getRegionChunkShift(),
                 this,
                 this.tickRegions
