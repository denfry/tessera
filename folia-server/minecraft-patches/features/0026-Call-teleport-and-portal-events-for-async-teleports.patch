+    private org.bukkit.@Nullable Location callTeleportEvent(ServerLevel destination, Vec3 pos, Float yaw, Float pitch,
+                                                            org.bukkit.event.player.PlayerTeleportEvent.TeleportCause cause) {
+        org.bukkit.Location to = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(
+            pos, destination, yaw == null ? this.getYRot() : yaw.floatValue(), pitch == null ? this.getXRot() : pitch.floatValue()
+        );
+        org.bukkit.Location from = this.getBukkitEntity().getLocation();
+        net.minecraft.world.level.block.entity.TheEndGatewayBlockEntity gateway = null;
+        if (cause == org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.END_GATEWAY && this.portalProcess != null
+            && this.portalProcess.isSamePortal((net.minecraft.world.level.block.EndGatewayBlock) Blocks.END_GATEWAY)
+            && this.level.getBlockEntity(this.portalProcess.getEntryPosition()) instanceof net.minecraft.world.level.block.entity.TheEndGatewayBlockEntity found) {
+            gateway = found;
+        }
+
+        org.bukkit.Location newTo;
+        if (this instanceof ServerPlayer player) {
+            org.bukkit.event.player.PlayerTeleportEvent event = gateway != null
+                ? new com.destroystokyo.paper.event.player.PlayerTeleportEndGatewayEvent(player.getBukkitEntity(), from, to.clone(), new org.bukkit.craftbukkit.block.CraftEndGateway(this.level.getWorld(), gateway, true))
+                : new org.bukkit.event.player.PlayerTeleportEvent(player.getBukkitEntity(), from, to.clone(), cause);
+            if (!event.callEvent()) {
+                return null;
+            }
+            newTo = event.getTo();
+        } else {
+            org.bukkit.event.entity.EntityTeleportEvent event = gateway != null
+                ? new com.destroystokyo.paper.event.entity.EntityTeleportEndGatewayEvent(this.getBukkitEntity(), from, to.clone(), new org.bukkit.craftbukkit.block.CraftEndGateway(this.level.getWorld(), gateway, true))
+                : new org.bukkit.event.entity.EntityTeleportEvent(this.getBukkitEntity(), from, to.clone());
+            if (!event.callEvent() || event.getTo() == null) {
+                return null;
+            }
+            newTo = event.getTo();
+        }
+
+        if (newTo.getWorld() == null || this.isRemoved()) {
+            return null;
+        }
+        return newTo.equals(to) ? TELEPORT_EVENT_UNCHANGED : newTo.clone();
+    }
+    // Tessera end - teleport events
 
