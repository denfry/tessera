+    protected boolean portalToAsync(ServerLevel requestedDestination, BlockPos portalPos, boolean takePassengers, // Tessera - portal events
                                     PortalType type, java.util.function.Consumer<Entity> teleportComplete) {
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this, "Cannot portal entity async");
-        if (!((ServerLevel)this.level).isAllowedToEnterPortal(destination)
-            || !this.canPortalAsync(destination, takePassengers)) {
+        if (!((ServerLevel)this.level).isAllowedToEnterPortal(requestedDestination) // Tessera - portal events
+            || !this.canPortalAsync(requestedDestination, takePassengers)) { // Tessera - portal events
+            return false;
+        }
+
+        // Tessera start - portal events
+        PortalTarget target = this.callPortalEvents((ServerLevel)this.level, requestedDestination, type);
+        if (target == null) {
             return false;
         }
+        ServerLevel destination = target.destination();
+        if (destination.tesseraUnloading || !this.canPortalAsync(destination, takePassengers)) {
+            return false;
+        }
+        if (target.exact() != null) {
+            // a listener picked the exact exit, there is no portal to search for
+            this.getSelfAndPassengers().forEach(Entity::setPortalCooldown);
+            org.bukkit.Location exit = target.exact();
+            return this.teleportAsync(
+                destination, org.bukkit.craftbukkit.util.CraftLocation.toVec3(exit),
+                Float.valueOf(exit.getYaw()), Float.valueOf(exit.getPitch()), Vec3.ZERO, target.cause(),
+                Entity.TELEPORT_FLAG_LOAD_CHUNK | Entity.TELEPORT_FLAG_NO_EVENT | (takePassengers ? Entity.TELEPORT_FLAG_TELEPORT_PASSENGERS : 0L),
+                (Entity teleported) -> {
+                    TeleportTransition.PLAY_PORTAL_SOUND.onTransition(teleported);
+                    if (teleportComplete != null) {
+                        teleportComplete.accept(teleported);
+                    }
+                }
+            );
+        }
+        // Tessera end - portal events
 
         Vec3 initialPosition = this.position();
         ChunkPos initialPositionChunk = new ChunkPos(
@@ -5010,7 +5217,7 @@ public abstract class Entity
         });
 
 
-        passengerTree.root.findOrCreatePortalAsync(originWorld, portalPos, destination, type, portalInfoCompletable);
+        passengerTree.root.findOrCreatePortalAsync(originWorld, portalPos, destination, type, target, portalInfoCompletable); // Tessera - portal events
 
         return true;
     }
@@ -5084,7 +5291,7 @@ public abstract class Entity
 
         this.teleportAsync(
             (ServerLevel)this.level(), this.position, null, null, null,
-            org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.UNKNOWN, Entity.TELEPORT_FLAG_LOAD_CHUNK | Entity.TELEPORT_FLAG_TELEPORT_PASSENGERS,
+            org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.UNKNOWN, Entity.TELEPORT_FLAG_LOAD_CHUNK | Entity.TELEPORT_FLAG_TELEPORT_PASSENGERS | Entity.TELEPORT_FLAG_NO_EVENT, // Tessera - teleport events - internal correction
