+    /**
+     * Fires the portal events on the origin region thread, before the entity is removed from the world:
+     * {@link io.papermc.paper.event.entity.EntityPortalReadyEvent} (nether only), then
+     * {@link org.bukkit.event.player.PlayerPortalEvent} / {@link org.bukkit.event.entity.EntityPortalEvent}, then
+     * {@link org.bukkit.event.player.PlayerTeleportEvent} / {@link org.bukkit.event.entity.EntityTeleportEvent}.
+     * The exit portal is not known yet, so the teleport event carries the approximate exit position.
+     * If a listener changes the target of the teleport event (or of the end portal event), the entity
+     * is teleported exactly there without a portal search.
+     *
+     * @return {@code null} if a listener cancelled the portal
+     */
+    private @Nullable PortalTarget callPortalEvents(ServerLevel origin, ServerLevel destination, PortalType type) {
+        if (type == PortalType.NETHER) {
+            io.papermc.paper.event.entity.EntityPortalReadyEvent readyEvent = new io.papermc.paper.event.entity.EntityPortalReadyEvent(
+                this.getBukkitEntity(), destination.getWorld(), org.bukkit.PortalType.NETHER
+            );
+            if (!readyEvent.callEvent()) {
+                this.portalProcess = null;
+                return null;
+            }
+            if (readyEvent.getTargetWorld() == null) {
+                return null;
+            }
+            destination = ((org.bukkit.craftbukkit.CraftWorld) readyEvent.getTargetWorld()).getHandle();
+
+            boolean destinationIsNether = destination.getTypeKey() == net.minecraft.world.level.dimension.LevelStem.NETHER;
+            int searchRadius = origin.paperConfig().environment.portalSearchVanillaDimensionScaling && destinationIsNether ?
+                (int)(destination.paperConfig().environment.portalSearchRadius / destination.dimensionType().coordinateScale()) :
+                destination.paperConfig().environment.portalSearchRadius;
+            double dimensionScale = net.minecraft.world.level.dimension.DimensionType.getTeleportationScale(origin.dimensionType(), destination.dimensionType());
+            BlockPos searchPos = destination.getWorldBorder().clampToBounds(this.getX() * dimensionScale, this.getY(), this.getZ() * dimensionScale);
+
+            org.bukkit.craftbukkit.event.PortalEventResult result = org.bukkit.craftbukkit.event.CraftEventFactory.handlePortalEvents(
+                this, org.bukkit.craftbukkit.util.CraftLocation.toBukkit(searchPos, destination), org.bukkit.PortalType.NETHER,
+                searchRadius, destination.paperConfig().environment.portalCreateRadius
+            );
+            if (result == null || this.isRemoved()) {
+                return null;
+            }
+            destination = ((org.bukkit.craftbukkit.CraftWorld) result.to().getWorld()).getHandle();
+            searchPos = destination.getWorldBorder().clampToBounds(result.to().getX(), result.to().getY(), result.to().getZ());
+
+            org.bukkit.Location exact = this.callTeleportEvent(destination, Vec3.atBottomCenterOf(searchPos), null, null, org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.NETHER_PORTAL);
+            if (exact == null) {
+                return null;
+            }
+            if (exact == TELEPORT_EVENT_UNCHANGED) {
+                exact = null;
+            } else {
+                destination = ((org.bukkit.craftbukkit.CraftWorld) exact.getWorld()).getHandle();
+            }
+            return new PortalTarget(
+                destination, searchPos, result.searchRadius(), result.createRadius(), result.canCreatePortal(), exact,
+                org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.NETHER_PORTAL
+            );
+        }
+
+        // end portal: the exit is fixed, so the events carry the real target
+        Vec3 exitPos;
+        float exitYaw;
+        if (destination.getTypeKey() == net.minecraft.world.level.dimension.LevelStem.END) {
+            exitPos = Vec3.atBottomCenterOf(ServerLevel.END_SPAWN_POINT.below());
+            exitYaw = Direction.WEST.toYRot();
+        } else {
+            exitPos = Vec3.atBottomCenterOf(destination.getRespawnData().pos());
+            exitYaw = this.getYRot();
+        }
+        org.bukkit.Location to = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(exitPos, destination, exitYaw, this.getXRot());
+        org.bukkit.craftbukkit.event.PortalEventResult result = org.bukkit.craftbukkit.event.CraftEventFactory.handlePortalEvents(
+            this, to.clone(), org.bukkit.PortalType.ENDER, 0, 0
+        );
+        if (result == null || this.isRemoved()) {
+            return null;
+        }
+        org.bukkit.Location exact = result.to().equals(to) ? null : result.to().clone();
+        destination = ((org.bukkit.craftbukkit.CraftWorld) result.to().getWorld()).getHandle();
+
+        org.bukkit.Location newTo = this.callTeleportEvent(
+            destination, org.bukkit.craftbukkit.util.CraftLocation.toVec3(result.to()),
+            Float.valueOf(result.to().getYaw()), Float.valueOf(result.to().getPitch()),
+            org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.END_PORTAL
+        );
+        if (newTo == null) {
+            return null;
+        }
+        if (newTo != TELEPORT_EVENT_UNCHANGED) {
+            exact = newTo;
+            destination = ((org.bukkit.craftbukkit.CraftWorld) newTo.getWorld()).getHandle();
+        }
+        return new PortalTarget(
+            destination, BlockPos.containing(exitPos), 0, 0, false, exact,
+            org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.END_PORTAL
+        );
+    }
