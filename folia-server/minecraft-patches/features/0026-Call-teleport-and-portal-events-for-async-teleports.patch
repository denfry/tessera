-    protected boolean portalToAsync(ServerLevel destination, BlockPos portalPos, boolean takePassengers,
+    // Tessera start - portal events
+    protected record PortalTarget(ServerLevel destination, BlockPos searchPos, int searchRadius, int createRadius,
+                                  boolean canCreatePortal, org.bukkit.@Nullable Location exact,
+                                  org.bukkit.event.player.PlayerTeleportEvent.TeleportCause cause) {}
