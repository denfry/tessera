From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Mon, 2 Nov 2026 08:32:05 +0300
Subject: [PATCH] Swap recipe data as a snapshot and reload players on their
 thread

A plugin changing recipes wrote to plain maps that furnaces and crafting
in other regions were reading, and the failed read removes the block
entity. Writes now publish new maps. Reloading advancements and the recipe
book for every online player ran on the calling thread, which raced with
the regions of those players and could lose progress.

Based on PaperMC/Folia#498 (the per-player reloads)

diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index f6efc60a839511587cc8c59db19bff8c88a44f3a..f2fad43146db939b85d7e2ac1df4dbdb86e41ac8 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -1444,6 +1444,11 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
             .forEach(mob -> ((NeutralMob)mob).playerDied(this.level(), this));
     }
 
+    // Tessera start - the advancements and recipe book of a player belong to the player's thread
+    public final java.util.concurrent.atomic.AtomicBoolean tesseraAdvancementReloadPending = new java.util.concurrent.atomic.AtomicBoolean();
+    public final java.util.concurrent.atomic.AtomicBoolean tesseraRecipeReloadPending = new java.util.concurrent.atomic.AtomicBoolean();
+    // Tessera end - the advancements and recipe book of a player belong to the player's thread
+
     @Override
     public void awardKillScore(final Entity victim, final DamageSource killingBlow) {
         // Tessera start - the killer can be in another region
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index ba55ca2c8c758fa03034488ecbaa5ea96e66a43a..37392f082cc360757256dbf500efb6e1129dc893 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -1388,8 +1388,17 @@ public abstract class PlayerList {
         //     playerAdvancements.reload(this.server.getAdvancements());
         // }
         for (ServerPlayer player : this.players) {
-            player.getAdvancements().reload(this.server.getAdvancements());
-            player.getAdvancements().flushDirty(player, false); // CraftBukkit - trigger immediate flush of advancements
+            // Tessera start - the advancements of a player belong to the player's thread
+            // A plugin adding many recipes asks for this once per recipe, and each reload is expensive.
+            if (!player.tesseraAdvancementReloadPending.compareAndSet(false, true)) {
+                continue;
+            }
+            player.getBukkitEntity().taskScheduler.schedule((ServerPlayer entityPlayer) -> {
+                entityPlayer.tesseraAdvancementReloadPending.set(false);
+                entityPlayer.getAdvancements().reload(this.server.getAdvancements());
+                entityPlayer.getAdvancements().flushDirty(entityPlayer, false); // CraftBukkit - trigger immediate flush of advancements
+            }, null, 20L);
+            // Tessera end - the advancements of a player belong to the player's thread
         }
         // CraftBukkit end
 
@@ -1410,8 +1419,17 @@ public abstract class PlayerList {
         );
 
         for (ServerPlayer player : this.players) {
-            player.connection.send(recipes);
-            player.getRecipeBook().sendInitialRecipeBook(player);
+            // Tessera start - the recipe book of a player belongs to the player's thread
+            if (!player.tesseraRecipeReloadPending.compareAndSet(false, true)) {
+                continue;
+            }
+            player.getBukkitEntity().taskScheduler.schedule((ServerPlayer entityPlayer) -> {
+                entityPlayer.tesseraRecipeReloadPending.set(false);
+                final RecipeManager currentRecipes = this.server.getRecipeManager();
+                entityPlayer.connection.send(new ClientboundUpdateRecipesPacket(currentRecipes.getSynchronizedItemProperties(), currentRecipes.getSynchronizedStonecutterRecipes()));
+                entityPlayer.getRecipeBook().sendInitialRecipeBook(entityPlayer);
+            }, null, 20L);
+            // Tessera end - the recipe book of a player belongs to the player's thread
         }
     }
 }
