From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Fri, 30 Oct 2026 12:20:40 +0300
Subject: [PATCH] Do not read a liked note block in another region

An allay remembers a note block up to 1024 blocks away and read its block
state from its own region. Without the check the read fails the thread check
and the allay is discarded. It follows the liked player until the block is
in its region again; the memory is kept.

Addresses PaperMC/Folia#203

diff --git a/net/minecraft/world/entity/animal/allay/AllayAi.java b/net/minecraft/world/entity/animal/allay/AllayAi.java
index 76e33f716b858707484952187b72ecda7ba4e469..052ea784a26bd3cf43f704b2832a4b5d5e985095 100644
--- a/net/minecraft/world/entity/animal/allay/AllayAi.java
+++ b/net/minecraft/world/entity/animal/allay/AllayAi.java
@@ -122,6 +122,12 @@ public class AllayAi {
         Optional<GlobalPos> likedNoteblockPos = brain.getMemory(MemoryModuleType.LIKED_NOTEBLOCK_POSITION);
         if (likedNoteblockPos.isPresent()) {
             GlobalPos position = likedNoteblockPos.get();
+            // Tessera start - the liked note block can be in another region
+            if (position.dimension() == allay.level().dimension()
+                && !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor((net.minecraft.server.level.ServerLevel)allay.level(), position.pos())) {
+                return getLikedPlayerPositionTracker(allay);
+            }
+            // Tessera end - the liked note block can be in another region
             if (shouldDepositItemsAtLikedNoteblock(allay, brain, position)) {
                 return Optional.of(new BlockPosTracker(position.pos().above()));
             }
