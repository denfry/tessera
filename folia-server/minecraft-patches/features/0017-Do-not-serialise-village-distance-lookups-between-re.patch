From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Thu, 29 Oct 2026 11:58:41 +0300
Subject: [PATCH] Do not serialise village distance lookups between regions

Region threading guarded the per-world village distance propagator with
one monitor and every PoiManager#sectionsToVillage call ran
propagateUpdates() inside it, so all lookups of a world were serialised,
not just source updates. Zombies at night (MoveThroughVillageGoal via
ServerLevel#isVillage) and every region's ChunkMap tick contend on it;
on a 95 player server region threads spent 30-36% of their time blocked
on that monitor.

Use a StampedLock: lookups take the shared read lock, and only source
changes and propagation of pending changes take the write lock. A dirty
flag skips propagation (and the write lock) when nothing changed.

Fixes PaperMC/Folia#530

diff --git a/net/minecraft/world/entity/ai/village/poi/PoiManager.java b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
index 816fae86e0ff6e7a7abe330dd8df3928f8309307..a44ef95e1a08b80a8c2bb01f60755eba6b04d88e 100644
--- a/net/minecraft/world/entity/ai/village/poi/PoiManager.java
+++ b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
@@ -52,6 +52,26 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
     // the vanilla tracker needs to be replaced because it does not support level removes, and we need level removes
     // to support poi unloading
     private final ca.spottedleaf.moonrise.common.misc.Delayed26WayDistancePropagator3D villageDistanceTracker = new ca.spottedleaf.moonrise.common.misc.Delayed26WayDistancePropagator3D();
+    // Tessera start - do not serialise village distance lookups between regions
+    // Lookups only need the read lock; the write lock is taken to change sources or to propagate pending changes.
+    private final java.util.concurrent.locks.StampedLock villageDistanceLock = new java.util.concurrent.locks.StampedLock();
+    private volatile boolean villageDistanceDirty;
+
+    private void propagateVillageDistance() {
+        if (!this.villageDistanceDirty) {
+            return;
+        }
+        final long stamp = this.villageDistanceLock.writeLock();
+        try {
+            if (this.villageDistanceDirty) {
+                this.villageDistanceDirty = false;
+                this.villageDistanceTracker.propagateUpdates();
+            }
+        } finally {
+            this.villageDistanceLock.unlockWrite(stamp);
+        }
+    }
+    // Tessera end - do not serialise village distance lookups between regions
 
     private static final int POI_DATA_SOURCE = 7;
 
@@ -60,13 +80,15 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
     }
 
     private void updateDistanceTracking(long section) {
-        synchronized (this.villageDistanceTracker) { // Folia - region threading
+        final long stamp = this.villageDistanceLock.writeLock(); // Folia - region threading // Tessera - do not serialise village distance lookups between regions
+        try { // Tessera - do not serialise village distance lookups between regions
         if (this.isVillageCenter(section)) {
             this.villageDistanceTracker.setSource(section, POI_DATA_SOURCE);
         } else {
             this.villageDistanceTracker.removeSource(section);
         }
-        } // Folia - region threading
+        this.villageDistanceDirty = true; // Tessera - do not serialise village distance lookups between regions
+        } finally { this.villageDistanceLock.unlockWrite(stamp); } // Folia - region threading // Tessera - do not serialise village distance lookups between regions
     }
 
     @Override
@@ -422,12 +444,15 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
     }
 
     public int sectionsToVillage(final SectionPos sectionPos) {
-        synchronized (this.villageDistanceTracker) { // Folia - region threading
+        // Tessera start - do not serialise village distance lookups between regions
+        this.propagateVillageDistance();
+        final long stamp = this.villageDistanceLock.readLock();
+        try {
+        // Tessera end - do not serialise village distance lookups between regions
         // Paper start - rewrite chunk system
-        this.villageDistanceTracker.propagateUpdates();
         return convertBetweenLevels(this.villageDistanceTracker.getLevel(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionKey(sectionPos)));
         // Paper end - rewrite chunk system
-        } // Folia - region threading
+        } finally { this.villageDistanceLock.unlockRead(stamp); } // Tessera - do not serialise village distance lookups between regions
     }
 
     private boolean isVillageCenter(final long sectionPos) {
@@ -438,9 +463,7 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
 
     @Override
     public void tick(final BooleanSupplier haveTime) {
-        synchronized (this.villageDistanceTracker) { // Folia - region threading
-        this.villageDistanceTracker.propagateUpdates(); // Paper - rewrite chunk system
-        } // Folia - region threading
+        this.propagateVillageDistance(); // Paper - rewrite chunk system // Tessera - do not serialise village distance lookups between regions
     }
 
     @Override
