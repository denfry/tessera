From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Fri, 30 Oct 2026 10:21:51 +0300
Subject: [PATCH] Run brigadier commands of plugins in compatibility mode on
 the global region thread


diff --git a/io/papermc/paper/threadedregions/TesseraRegionLoan.java b/io/papermc/paper/threadedregions/TesseraRegionLoan.java
index fcab79e37046ae1a6d3d0a9040d04c7901b6e6a3..9f6f3f852729e354a5260cde7f7d5e6c80d206b6 100644
--- a/io/papermc/paper/threadedregions/TesseraRegionLoan.java
+++ b/io/papermc/paper/threadedregions/TesseraRegionLoan.java
@@ -56,6 +56,13 @@ public final class TesseraRegionLoan {
         }
     }
 
+    /**
+     * Returns whether the current thread runs a task inside {@link #runInScope(Runnable)}.
+     */
+    public static boolean isInScope() {
+        return RegionizedServer.isGlobalTickThread() && inScope;
+    }
+
     static boolean isBorrowed(final TickRegions.TickRegionData region) {
         return !BORROWED.isEmpty() && BORROWED.contains(region);
     }
diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index f2cf45afc1e898d1afd42460a279c43cc16382b2..0d73e0ee6d063440540bd9ddb386a4fccbda73c6 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -373,6 +373,13 @@ public class Commands {
     public void performCommand(final ParseResults<CommandSourceStack> command, final String commandString, final boolean throwCommandError) {
         org.spigotmc.AsyncCatcher.catchOp("Cannot perform command async");
         // Paper end
+        // Tessera start - brigadier commands of plugins in compatibility mode run on the global region thread
+        final org.bukkit.plugin.Plugin compatPlugin = io.papermc.paper.threadedregions.TesseraCompat.compatOwner(command);
+        if (compatPlugin != null && !io.papermc.paper.threadedregions.TesseraRegionLoan.isInScope()) {
+            io.papermc.paper.threadedregions.TesseraCompat.runCommand(compatPlugin, command.getContext().getSource().getBukkitSender(), commandString, () -> this.performCommand(command, commandString, throwCommandError));
+            return;
+        }
+        // Tessera end - brigadier commands of plugins in compatibility mode run on the global region thread
         CommandSourceStack sender = command.getContext().getSource();
         Profiler.get().push(() -> "/" + commandString);
         ContextChain<CommandSourceStack> commandChain = finishParsing(command, commandString, sender);
