From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Thu, 29 Oct 2026 11:57:24 +0300
Subject: [PATCH] Validate region ownership in AI behaviours

Brain memories and sensor results keep references to entities, beds,
job sites and leash targets after those move into another region or
dimension. Reading them from the wrong region throws a thread check
exception inside Level#guardEntityTick, which then discards the ticking
mob (villagers, allays, babies, leashed animals, their vehicles).

Check ownership before reading cached targets:
- nearest living/visible entity sensors and memories, BabyFollowAdult
- AssignProfessionFromJobSite (other dimension or region job site)
- JumpOnBed bed lookups
- GoToWantedItem item targets, including targets replaced by plugins
- delayed leash info pointing to an entity or knot in another region

Based on PaperMC/Folia#523, #525, #526, #527 (PluginsKers) and
PaperMC/Folia#495 (Dueris)

diff --git a/net/minecraft/world/entity/Leashable.java b/net/minecraft/world/entity/Leashable.java
index 98034a4c96bf2972316078d3b3a49140921aab50..ce1ec95ebdfbc199fce9539671a8dd18166279b6 100644
--- a/net/minecraft/world/entity/Leashable.java
+++ b/net/minecraft/world/entity/Leashable.java
@@ -94,11 +94,11 @@ public interface Leashable {
             Optional<BlockPos> pos = leashData.delayedLeashInfo.right();
             if (leashUuid.isPresent()) {
                 Entity leasher = serverLevel.getEntity(leashUuid.get());
-                if (leasher != null) {
+                if (leasher != null && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(leasher)) { // Tessera - region threading
                     setLeashedTo(entity, leasher, true);
                     return;
                 }
-            } else if (pos.isPresent()) {
+            } else if (pos.isPresent() && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(serverLevel, pos.get())) { // Tessera - region threading
                 setLeashedTo(entity, LeashFenceKnotEntity.getOrCreateKnot(serverLevel, pos.get()), true);
                 return;
             }
diff --git a/net/minecraft/world/entity/ai/behavior/AssignProfessionFromJobSite.java b/net/minecraft/world/entity/ai/behavior/AssignProfessionFromJobSite.java
index bae514a553838e5e4a3d91a2713693a4847aad02..dfc75e52679024c23dc154b86a599bc870a8e9d5 100644
--- a/net/minecraft/world/entity/ai/behavior/AssignProfessionFromJobSite.java
+++ b/net/minecraft/world/entity/ai/behavior/AssignProfessionFromJobSite.java
@@ -20,6 +20,11 @@ public class AssignProfessionFromJobSite {
                     i,
                     (potentialJobSite, jobSite) -> (level, body, timestamp) -> {
                         GlobalPos pos = i.get(potentialJobSite);
+                        // Tessera start - region threading
+                        if (pos.dimension() != level.dimension() || !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(level, pos.pos())) {
+                            return false;
+                        }
+                        // Tessera end - region threading
                         if (!pos.pos().closerToCenterThan(body.position(), 2.0)) {
                             return false;
                         }
