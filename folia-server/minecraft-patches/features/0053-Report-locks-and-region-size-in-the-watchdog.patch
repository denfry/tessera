+    // Tessera start - detailed watchdog report
+    // Like jstack: thread state, the lock the thread waits for and its owner, the monitors and locks it holds.
+    // The owner of the awaited lock is dumped too (a few hops), since a hung region usually waits for another thread.
+    private static final int MAX_LOCK_OWNER_HOPS = 3;
+
+    private static void dumpThreadWithLocks(final Thread thread) {
+        final ThreadMXBean threads = ManagementFactory.getThreadMXBean();
+        final long[] deadlocked = threads.isSynchronizerUsageSupported() ? threads.findDeadlockedThreads() : threads.findMonitorDeadlockedThreads();
+        final Set<Long> dumped = new HashSet<>();
+        long threadId = thread.threadId();
+        for (int hop = 0; hop <= MAX_LOCK_OWNER_HOPS && threadId != -1L && dumped.add(threadId); ++hop) {
+            final ThreadInfo info = threads.getThreadInfo(
+                new long[] { threadId }, threads.isObjectMonitorUsageSupported(), threads.isSynchronizerUsageSupported(), Integer.MAX_VALUE
+            )[0];
+            if (info == null) {
+                break;
+            }
+            dumpThreadInfo(info, hop == 0 ? "Region thread" : "Owner of the awaited lock", contains(deadlocked, threadId));
+            threadId = info.getLockOwnerId();
+        }
+    }
+
+    private static void dumpThreadInfo(final ThreadInfo info, final String role, final boolean deadlocked) {
+        LOGGER.error("------------------------------");
+        LOGGER.error(role + ": " + info.getThreadName() + " | id: " + info.getThreadId() + " | state: " + info.getThreadState()
+            + (info.isInNative() ? " | in native code" : "") + (deadlocked ? " | DEADLOCKED" : ""));
+        if (info.getLockName() != null) {
+            LOGGER.error("	Waiting for: " + info.getLockName()
+                + (info.getLockOwnerName() != null ? " held by " + info.getLockOwnerName() + " (id " + info.getLockOwnerId() + ")" : ""));
+        }
+        LOGGER.error("	Stack:");
+        final StackTraceElement[] stack = info.getStackTrace();
+        final MonitorInfo[] monitors = info.getLockedMonitors();
+        for (int i = 0; i < stack.length; ++i) {
+            LOGGER.error("		" + stack[i]);
+            for (final MonitorInfo monitor : monitors) {
+                if (monitor.getLockedStackDepth() == i) {
+                    LOGGER.error("			- locked " + monitor);
+                }
+            }
+        }
+        final LockInfo[] synchronizers = info.getLockedSynchronizers();
+        if (synchronizers.length != 0) {
+            LOGGER.error("	Held locks:");
+            for (final LockInfo lock : synchronizers) {
+                LOGGER.error("		- " + lock);
+            }
+        }
+    }
+
+    private static boolean contains(final long[] ids, final long id) {
+        if (ids != null) {
+            for (final long other : ids) {
+                if (other == id) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+    // Tessera end - detailed watchdog report
