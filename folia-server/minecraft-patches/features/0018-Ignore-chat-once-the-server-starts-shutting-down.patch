From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Thu, 29 Oct 2026 13:28:37 +0300
Subject: [PATCH] Ignore chat once the server starts shutting down

Paper drops chat packets when MinecraftServer#isStopped is true, but on
Folia the regions are halted by RegionShutdownThread before that flag is
set, so players can still chat (and fire chat events into plugins that
are being disabled) while the server shuts down. Track the shutdown in
RegionShutdownThread and drop chat once it has started.

Based on PaperMC/Folia#461 (Dueris)

diff --git a/io/papermc/paper/threadedregions/RegionShutdownThread.java b/io/papermc/paper/threadedregions/RegionShutdownThread.java
index 68751f44518a9451e1bf87a441926ce61d8c04dd..2f32561883e97c89215d48aca88c25d1567e9038 100644
--- a/io/papermc/paper/threadedregions/RegionShutdownThread.java
+++ b/io/papermc/paper/threadedregions/RegionShutdownThread.java
@@ -17,6 +17,7 @@ import java.util.concurrent.TimeUnit;
 public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.util.TickThread {
 
     private static final Logger LOGGER = LogUtils.getClassLogger();
+    private static volatile boolean shuttingDownServer; // Tessera - chat during shutdown
 
     ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> shuttingDown;
 
@@ -27,6 +28,12 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
         });
     }
 
+    // Tessera start - chat during shutdown
+    public static boolean isShuttingDown() {
+        return shuttingDownServer;
+    }
+    // Tessera end - chat during shutdown
+
     static ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> getRegion() {
         final Thread currentThread = Thread.currentThread();
         if (currentThread instanceof RegionShutdownThread shutdownThread) {
@@ -151,6 +158,7 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
 
     @Override
     public final void run() {
+        shuttingDownServer = true; // Tessera - chat during shutdown
         // await scheduler termination
         LOGGER.info("Awaiting scheduler termination for 60s...");
         if (TickRegions.getScheduler().halt(true, TimeUnit.SECONDS.toNanos(60L))) {
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 35c1a7a250ed43c4bc45fc80835974003ce2a8e0..d412a84de36cd57c92e8a38293c93cd8c2a89f1e 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -2458,7 +2458,7 @@ public class ServerGamePacketListenerImpl
     public void handleChat(final ServerboundChatPacket packet) {
         // CraftBukkit start - async chat
         // SPIGOT-3638
-        if (this.server.isStopped()) {
+        if (this.server.isStopped() || io.papermc.paper.threadedregions.RegionShutdownThread.isShuttingDown()) { // Tessera - Folia never sets isStopped before regions halt
             return;
         }
         // CraftBukkit end
