@@ -152,6 +152,17 @@ public final class TickRegionScheduler {
         }
     }
 
+    // Tessera start - region loans for plugins in compatibility mode
+    private static final long TESSERA_BORROWED_RETRY_NS = TimeUnit.MILLISECONDS.toNanos(1L);
+
+    // unlike setTickingRegion, switches between regions without unsetting; only for the global tick thread
+    static void tesseraSetTickingRegion(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region) {
+        final TickThreadRunner tickThreadRunner = (TickThreadRunner)Thread.currentThread();
+        tickThreadRunner.currentTickingRegion = region;
+        tickThreadRunner.currentTickingWorldRegionizedData = region == null ? null : region.regioniser.world.worldRegionData.get();
+    }
+    // Tessera end - region loans for plugins in compatibility mode
+
     private static void setTickTask(final SchedulableTick task) {
         final Thread currThread = Thread.currentThread();
         if (!(currThread instanceof TickThreadRunner tickThreadRunner)) {
@@ -374,6 +385,12 @@ public final class TickRegionScheduler {
 
             if (!this.tryMarkTicking()) {
                 if (!this.cancelled.get()) {
+                    // Tessera start - region loans for plugins in compatibility mode
+                    if (this.region != null && TesseraRegionLoan.isBorrowed(this.region)) {
+                        // the global tick thread holds this region for a plugin task
+                        return true;
+                    }
+                    // Tessera end - region loans for plugins in compatibility mode
                     throw new IllegalStateException("Scheduled region should be acquirable");
                 }
                 // region was killed
@@ -434,6 +451,13 @@ public final class TickRegionScheduler {
 
             if (!this.tryMarkTicking()) {
                 if (!this.cancelled.get()) {
+                    // Tessera start - region loans for plugins in compatibility mode
+                    if (this.region != null && TesseraRegionLoan.isBorrowed(this.region)) {
+                        // the global tick thread holds this region for a plugin task, try again shortly
+                        this.setScheduledStart(tickStart + TESSERA_BORROWED_RETRY_NS);
+                        return true;
+                    }
+                    // Tessera end - region loans for plugins in compatibility mode
                     throw new IllegalStateException("Scheduled region should be acquirable");
                 }
                 // region was killed
