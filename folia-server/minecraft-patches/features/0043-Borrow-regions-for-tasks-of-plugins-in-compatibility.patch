         // Tessera start - BukkitScheduler tasks of plugins in compatibility mode run on the global region
         if (io.papermc.paper.threadedregions.TesseraCompat.enabled()) {
-            ((org.bukkit.craftbukkit.CraftServer)Bukkit.getServer()).getScheduler().mainThreadHeartbeat();
+            TesseraRegionLoan.runInScope(((org.bukkit.craftbukkit.CraftServer)Bukkit.getServer()).getScheduler()::mainThreadHeartbeat);
         }
         // Tessera end - BukkitScheduler tasks of plugins in compatibility mode run on the global region
 
diff --git a/io/papermc/paper/threadedregions/TesseraRegionLoan.java b/io/papermc/paper/threadedregions/TesseraRegionLoan.java
new file mode 100644
index 0000000000000000000000000000000000000000..e9d9ae5f64cbb717fbca54009855c7ec25c70345
--- /dev/null
+++ b/io/papermc/paper/threadedregions/TesseraRegionLoan.java
@@ -0,0 +1,114 @@
+package io.papermc.paper.threadedregions;
+
+import com.mojang.logging.LogUtils;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.locks.LockSupport;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.Level;
+import org.slf4j.Logger;
+
+/**
+ * Lets the global tick thread borrow regions while it runs tasks of plugins in compatibility mode.
+ * <p>
+ * Inside {@link #runInScope(Runnable)}, a failed thread check calls {@link #borrow(Level, int, int)}: the region
+ * owning the chunk is marked as ticking, so no scheduler thread can tick it, and becomes the current region of the
+ * global tick thread. Every region borrowed this way is released when the scope ends. A borrowed region skips its
+ * ticks until then. See COMPAT.md.
+ */
+public final class TesseraRegionLoan {
+
+    private static final Logger LOGGER = LogUtils.getClassLogger();
+    private static final long MAX_WAIT_NS = TimeUnit.MILLISECONDS.toNanos(500L);
+
+    // read by the scheduler threads to tell a borrowed region from a broken one
+    private static final Set<TickRegions.TickRegionData> BORROWED = ConcurrentHashMap.newKeySet();
+    // only accessed by the global tick thread
+    private static final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> HELD = new ArrayList<>();
+    private static boolean inScope;
+
+    private TesseraRegionLoan() {
+    }
+
+    /**
+     * Runs the task with region loans allowed, then releases every borrowed region. Outside the global tick thread,
+     * or when already in a scope, just runs the task.
+     */
+    public static void runInScope(final Runnable run) {
+        if (!RegionizedServer.isGlobalTickThread() || inScope || TickRegionScheduler.getCurrentRegion() != null) {
+            run.run();
+            return;
+        }
+        inScope = true;
+        try {
+            run.run();
+        } finally {
+            inScope = false;
+            releaseAll();
+        }
+    }
+
+    static boolean isBorrowed(final TickRegions.TickRegionData region) {
+        return !BORROWED.isEmpty() && BORROWED.contains(region);
+    }
+
+    /**
+     * Borrows the region owning the chunk and makes it the current region, if the current thread is the global tick
+     * thread inside {@link #runInScope(Runnable)}. Returns {@code false} if not in a scope, if the chunk has no region
+     * (it is not loaded), or if the region could not be acquired in time.
+     */
+    public static boolean borrow(final Level level, final int chunkX, final int chunkZ) {
+        if (!RegionizedServer.isGlobalTickThread() || !inScope || !(level instanceof ServerLevel world)) {
+            return false;
+        }
+
+        final long deadline = System.nanoTime() + MAX_WAIT_NS;
+        for (;;) {
+            final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
+                world.regioniser.getRegionAtUnsynchronised(chunkX, chunkZ);
+            if (region == null) {
+                return false;
+            }
+            if (HELD.contains(region)) {
+                TickRegionScheduler.tesseraSetTickingRegion(region);
+                return true;
+            }
+
+            // mark first: once acquired, the scheduler must see the region as borrowed
+            BORROWED.add(region.getData());
+            if (region.tryMarkTicking(() -> false)) {
+                HELD.add(region);
+                TickRegionScheduler.tesseraSetTickingRegion(region);
+                return true;
+            }
+            BORROWED.remove(region.getData());
+
+            // the region is ticking right now, or being merged
+            if (System.nanoTime() - deadline > 0L) {
+                LOGGER.warn("Could not borrow region {} for a plugin task in {} ms", region.getCenterChunk(), TimeUnit.NANOSECONDS.toMillis(MAX_WAIT_NS));
+                return false;
+            }
+            LockSupport.parkNanos(20_000L);
+        }
+    }
+
+    private static void releaseAll() {
+        if (HELD.isEmpty()) {
+            return;
+        }
+        TickRegionScheduler.tesseraSetTickingRegion(null);
+        for (final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region : HELD) {
+            try {
+                region.markNotTicking();
+            } catch (final Throwable thr) {
+                LOGGER.error("Failed to release borrowed region " + region, thr);
+            } finally {
+                BORROWED.remove(region.getData());
+            }
+        }
+        HELD.clear();
+    }
+}
