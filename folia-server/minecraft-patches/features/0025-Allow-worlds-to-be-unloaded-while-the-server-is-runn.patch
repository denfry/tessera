From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Thu, 29 Oct 2026 14:48:36 +0300
Subject: [PATCH] Allow worlds to be unloaded while the server is running

The chunks of a world are owned by the regions that tick it, so a world
cannot simply be closed from another thread. To unload a world, take
every region of the world from the scheduler the same way the scheduler
acquires a region before ticking it, then save and close the world on a
shutdown thread exactly like on server shutdown. Teleports into a world
that is being unloaded are refused.

Also track whether the region scheduler has started, so that worlds can
be created by plugins while they are enabled on startup.

Part of PaperMC/Folia#134

diff --git a/io/papermc/paper/threadedregions/RegionShutdownThread.java b/io/papermc/paper/threadedregions/RegionShutdownThread.java
index f7755bd21513bed2725959e37096e26ad32003c3..dd75e78fee5f35f6b0488e1f0d37aad0cd86f218 100644
--- a/io/papermc/paper/threadedregions/RegionShutdownThread.java
+++ b/io/papermc/paper/threadedregions/RegionShutdownThread.java
@@ -20,14 +20,131 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
     private static volatile boolean shuttingDownServer; // Tessera - chat during shutdown
 
     ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> shuttingDown;
+    // Tessera start - world loading API
+    private final ServerLevel unloadingWorld;
+    private final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> unloadingRegions;
+    private final boolean unloadingSave;
+    // Tessera end - world loading API
 
     public RegionShutdownThread(final String name) {
         super(name);
         this.setUncaughtExceptionHandler((thread, thr) -> {
             LOGGER.error("Error shutting down server", thr);
         });
+        // Tessera start - world loading API
+        this.unloadingWorld = null;
+        this.unloadingRegions = null;
+        this.unloadingSave = false;
+        // Tessera end - world loading API
     }
 
+    // Tessera start - world loading API
+    private RegionShutdownThread(final ServerLevel world, final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> regions,
+                                 final boolean save) {
+        super("Tessera World Unload Thread - " + WorldUtil.getWorldName(world));
+        this.setUncaughtExceptionHandler((thread, thr) -> {
+            LOGGER.error("Error unloading world '" + WorldUtil.getWorldName(world) + "'", thr);
+        });
+        this.unloadingWorld = world;
+        this.unloadingRegions = regions;
+        this.unloadingSave = save;
+    }
+
+    /**
+     * Saves and closes a world while the rest of the server keeps ticking. The caller must be on the global region and
+     * make sure that no player is in the world.
+     * <p>
+     * First every region of the world is taken from the scheduler, the same way the scheduler acquires a region before
+     * ticking it, so nothing ticks the world anymore. Then the world is saved and its chunk system is closed on a
+     * shutdown thread, exactly like on server shutdown.
+     * </p>
+     */
+    public static void unloadWorld(final ServerLevel world, final boolean save) {
+        RegionizedServer.ensureGlobalTickThread("Cannot unload world off global tick thread");
+
+        final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> acquired = new ArrayList<>();
+        for (;;) {
+            final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> regions = new ArrayList<>();
+            world.regioniser.computeForAllRegions(regions::add);
+
+            boolean waiting = false;
+            for (final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region : regions) {
+                if (acquired.contains(region)) {
+                    continue;
+                }
+                // a cancelled region is never ticked again by the scheduler
+                region.getData().getRegionSchedulingHandle().markNonSchedulable();
+                if (region.tryMarkTicking(() -> false)) {
+                    acquired.add(region);
+                } else if (!region.tesseraIsTransient()) {
+                    // still ticking on another thread
+                    waiting = true;
+                }
+                // transient regions wait to be merged into a region that we hold now, so they cannot tick either
+            }
+            if (!waiting) {
+                break;
+            }
+            Thread.onSpinWait();
+        }
+
+        final RegionShutdownThread thread = new RegionShutdownThread(world, acquired, save);
+        thread.start();
+        boolean interrupted = false;
+        for (;;) {
+            try {
+                thread.join();
+                break;
+            } catch (final InterruptedException ex) {
+                interrupted = true;
+            }
+        }
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private void unloadWorld() {
+        final ServerLevel world = this.unloadingWorld;
+        LOGGER.info("Unloading world '" + WorldUtil.getWorldName(world) + "'");
+        try {
+            world.moonrise$getChunkTaskScheduler().halt(false, 0L);
+        } catch (final Throwable throwable) {
+            LOGGER.error("Failed to soft halt chunk system for world '" + WorldUtil.getWorldName(world) + "'", throwable);
+        }
+        this.haltChunkSystem(world);
+
+        // include transient regions as well
+        final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> regions = new ArrayList<>();
+        world.regioniser.computeForAllRegionsUnsynchronised(regions::add);
+        for (int i = 0, len = regions.size(); i < len; ++i) {
+            this.finishTeleportations(regions.get(i), world);
+        }
+
+        if (this.unloadingSave && !regions.isEmpty()) {
+            for (int i = 0, len = regions.size(); i < len; ++i) {
+                this.saveRegionChunks(regions.get(i), (i + 1) == len);
+            }
+        } else {
+            try {
+                world.moonrise$getChunkTaskScheduler().chunkHolderManager.close(false, true, false, true, false);
+            } catch (final Throwable thr) {
+                LOGGER.error("Failed to close chunk system for world '" + WorldUtil.getWorldName(world) + "'", thr);
+            }
+        }
+
+        if (this.unloadingSave) {
+            this.saveLevelData(world);
+        }
+        try {
+            world.getChunkSource().getDataStorage().close();
+        } catch (final Throwable thr) {
+            LOGGER.error("Failed to close saved data for world '" + WorldUtil.getWorldName(world) + "'", thr);
+        }
+        LOGGER.info("Unloaded world '" + WorldUtil.getWorldName(world) + "'");
+    }
+    // Tessera end - world loading API
+
     // Tessera start - chat during shutdown
     public static boolean isShuttingDown() {
         return shuttingDownServer;
@@ -205,6 +322,12 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
 
     @Override
     public final void run() {
+        // Tessera start - world loading API
+        if (this.unloadingWorld != null) {
+            this.unloadWorld();
+            return;
+        }
+        // Tessera end - world loading API
         shuttingDownServer = true; // Tessera - chat during shutdown
         // await scheduler termination
         LOGGER.info("Awaiting scheduler termination for 60s...");
