diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index 762822ce2ccf98952dc92be4824c48fe6bc1bacb..01004a432e727c1de46b13e70de839feb0b28354 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -405,10 +405,16 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
                            final io.papermc.paper.threadedregions.TickRegions.TickRegionData region) {
         super.tickServer(startTime, scheduledEnd, targetBuffer, region);
         // Folia end - region threading
+        // Tessera - management server connections tick on the global tick, see tickManagementServer
+    }
+
+    // Tessera start - management server on Folia
+    public void tickManagementServer() {
         if (this.jsonRpcServer != null) {
             this.jsonRpcServer.tick();
         }
     }
+    // Tessera end - management server on Folia
 
     @Override
     public boolean saveAllChunks(final boolean silent, final boolean flush, final boolean force, final boolean close) { // Paper - rewrite chunk system - add close param
diff --git a/net/minecraft/server/jsonrpc/internalapi/MinecraftExecutorServiceImpl.java b/net/minecraft/server/jsonrpc/internalapi/MinecraftExecutorServiceImpl.java
index 81d21b23932fb7b4887cfcc16381d348385a3bf8..a204792a39fc248cbe174bad7eb5fd9a275f7fe4 100644
--- a/net/minecraft/server/jsonrpc/internalapi/MinecraftExecutorServiceImpl.java
+++ b/net/minecraft/server/jsonrpc/internalapi/MinecraftExecutorServiceImpl.java
@@ -19,11 +19,27 @@ public class MinecraftExecutorServiceImpl implements MinecraftExecutorService {
 
     @Override
     public <V> CompletableFuture<V> submit(final Supplier<V> supplier) {
-        return this.server().submit(supplier);
+        // Tessera start - management server on Folia, the server main thread does not run tasks, the global tick does
+        if (io.papermc.paper.threadedregions.RegionizedServer.isGlobalTickThread()) {
+            return CompletableFuture.completedFuture(supplier.get());
+        }
+        final CompletableFuture<V> future = new CompletableFuture<>();
+        io.papermc.paper.threadedregions.RegionizedServer.getInstance().addTask(() -> {
+            try {
+                future.complete(supplier.get());
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return future;
+        // Tessera end - management server on Folia, the server main thread does not run tasks, the global tick does
     }
 
     @Override
     public CompletableFuture<Void> submit(final Runnable runnable) {
-        return this.server().submit(runnable);
+        return this.submit(() -> { // Tessera - management server on Folia
+            runnable.run();
+            return null;
+        });
     }
 }
