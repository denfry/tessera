+++ b/io/papermc/paper/threadedregions/RegionizedServer.java
@@ -273,6 +273,12 @@ public final class RegionizedServer {
         // tick player ping sample
         this.tickPlayerSample();
 
+        // Tessera start - management server on Folia
+        if (net.minecraft.server.MinecraftServer.getServer() instanceof net.minecraft.server.dedicated.DedicatedServer dedicatedServer) {
+            dedicatedServer.tickManagementServer();
+        }
+        // Tessera end - management server on Folia
+
         // tick worlds
         for (final ServerLevel world : this.worlds) {
             this.globalTick(world, tickCount);
