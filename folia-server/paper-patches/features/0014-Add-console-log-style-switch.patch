From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Fri, 30 Oct 2026 09:00:53 +0300
Subject: [PATCH] Add console log style switch

The console layout is now chosen by the tessera.log.style system property or the TESSERA_LOG_STYLE environment variable, since panels make JVM flags awkward to change. 'classic' keeps the Paper console format byte for byte, 'pretty' (the default) drops the brackets and aligns the level. The log file format is the same in every style.

diff --git a/src/main/java/io/papermc/paper/log/TesseraLogStyle.java b/src/main/java/io/papermc/paper/log/TesseraLogStyle.java
new file mode 100644
index 0000000000000000000000000000000000000000..757ba05726dfcb2c9720941686b8ec5c0c788d95
--- /dev/null
+++ b/src/main/java/io/papermc/paper/log/TesseraLogStyle.java
@@ -0,0 +1,44 @@
+package io.papermc.paper.log;
+
+import java.util.Locale;
+
+// Tessera start - console log style
+/**
+ * Picks the console log style before Log4j starts. {@code log4j2.xml} selects the console layout by the
+ * {@value #PROPERTY} system property; this fills it from the {@value #ENV} environment variable (panels make
+ * JVM flags awkward to change) and falls back to {@code pretty} on unknown values.
+ */
+public final class TesseraLogStyle {
+
+    public static final String PROPERTY = "tessera.log.style";
+    public static final String ENV = "TESSERA_LOG_STYLE";
+    public static final String CLASSIC = "classic";
+    public static final String PRETTY = "pretty";
+
+    private TesseraLogStyle() {
+    }
+
+    public static void init() {
+        String raw = System.getProperty(PROPERTY);
+        if (raw == null || raw.isBlank()) {
+            raw = System.getenv(ENV);
+        }
+        System.setProperty(PROPERTY, resolve(raw));
+    }
+
+    static String resolve(final String raw) {
+        if (raw == null || raw.isBlank()) {
+            return PRETTY;
+        }
+        final String style = raw.trim().toLowerCase(Locale.ROOT);
+        return switch (style) {
+            case CLASSIC, PRETTY -> style;
+            default -> {
+                // Log4j is not up yet
+                System.err.println("Unknown log style '" + raw + "' in " + PROPERTY + "/" + ENV + ", using " + PRETTY + " (expected " + CLASSIC + " or " + PRETTY + ")");
+                yield PRETTY;
+            }
+        };
+    }
+}
+// Tessera end - console log style
