diff --git a/src/main/java/io/papermc/paper/threadedregions/TesseraCompat.java b/src/main/java/io/papermc/paper/threadedregions/TesseraCompat.java
new file mode 100644
index 0000000000000000000000000000000000000000..b9e1503485923bf3e8c9208afbb94b006b97ba6d
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/TesseraCompat.java
@@ -0,0 +1,110 @@
+package io.papermc.paper.threadedregions;
+
+import com.mojang.logging.LogUtils;
+import java.io.IOException;
+import java.io.Reader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import org.bukkit.plugin.Plugin;
+import org.slf4j.Logger;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.error.YAMLException;
+
+/**
+ * Compatibility mode for plugins that are not marked as supporting Folia.
+ * <p>
+ * Plugins listed in {@code tessera.yml} are loaded even without {@code folia-supported: true}, and their
+ * {@link org.bukkit.scheduler.BukkitScheduler} tasks run on the global region thread. Plugins that are marked
+ * as supporting Folia are not affected.
+ */
+public final class TesseraCompat {
+
+    private static final Logger LOGGER = LogUtils.getClassLogger();
+    private static final String DEFAULT_CONFIG = """
+        # Tessera settings.
+
+        compat:
+          # Plugins that are not marked as supporting Folia (folia-supported: true) but are loaded anyway,
+          # by plugin name, or "*" for all of them. Their BukkitScheduler tasks run on the global region
+          # thread. Changing blocks or entities from such a task still fails off the owning region thread.
+          plugins: []
+        """;
+
+    private static volatile Set<String> plugins = Set.of();
+    private static volatile boolean allPlugins;
+
+    private TesseraCompat() {
+    }
+
+    public static void load(final Path file) {
+        try {
+            if (Files.notExists(file)) {
+                if (file.getParent() != null) {
+                    Files.createDirectories(file.getParent());
+                }
+                Files.writeString(file, DEFAULT_CONFIG);
+            }
+
+            final Object root;
+            try (final Reader reader = Files.newBufferedReader(file)) {
+                root = new Yaml().load(reader);
+            }
+
+            final Set<String> names = new HashSet<>();
+            boolean all = false;
+            if (root instanceof Map<?, ?> map && map.get("compat") instanceof Map<?, ?> compat
+                && compat.get("plugins") instanceof List<?> list) {
+                for (final Object entry : list) {
+                    final String name = entry == null ? "" : entry.toString().trim();
+                    if (name.equals("*")) {
+                        all = true;
+                    } else if (!name.isEmpty()) {
+                        names.add(name.toLowerCase(Locale.ROOT));
+                    }
+                }
+            }
+            plugins = Set.copyOf(names);
+            allPlugins = all;
+        } catch (final IOException | YAMLException ex) {
+            LOGGER.error("Could not read {}, compatibility mode is off", file, ex);
+        }
+    }
+
+    /**
+     * Returns whether any plugin may run in compatibility mode.
+     */
+    public static boolean enabled() {
+        return allPlugins || !plugins.isEmpty();
+    }
+
+    /**
+     * Returns whether a plugin that is not marked as supporting Folia may be loaded.
+     */
+    public static boolean isListed(final String pluginName) {
+        return allPlugins || plugins.contains(pluginName.toLowerCase(Locale.ROOT));
+    }
+
+    /**
+     * Same as {@link #isListed(String)}, and logs that the plugin is loaded in compatibility mode.
+     */
+    public static boolean allowUnsupported(final String pluginName) {
+        if (!isListed(pluginName)) {
+            return false;
+        }
+        LOGGER.warn("Loading {} in compatibility mode: it is not marked as supporting Folia. "
+            + "Its scheduler tasks run on the global region thread; changing blocks or entities from them may fail.", pluginName);
+        return true;
+    }
+
+    /**
+     * Returns whether a loaded plugin runs in compatibility mode.
+     */
+    public static boolean isCompat(final Plugin plugin) {
+        return !plugin.getPluginMeta().isFoliaSupported();
+    }
+}
diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
index c4dcddc4db02ed3641d05fae31ead7c13205f841..deae476c8e6e75476b6bed1a2d7a2ddf07221370 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
@@ -514,7 +514,11 @@ public class CraftScheduler implements BukkitScheduler {
     }
 
     protected CraftTask handle(final CraftTask task, final long delay) { // Paper
-        if (true) throw new UnsupportedOperationException(); // Folia - region threading
+        // Tessera start - run BukkitScheduler tasks of plugins in compatibility mode
+        if (!io.papermc.paper.threadedregions.TesseraCompat.enabled() || (task.getOwner() != null && !io.papermc.paper.threadedregions.TesseraCompat.isCompat(task.getOwner()))) {
+            throw new UnsupportedOperationException(); // Folia - region threading
+        }
+        // Tessera end - run BukkitScheduler tasks of plugins in compatibility mode
         // Paper start
         if (!this.isAsyncScheduler && !task.isSync()) {
             this.asyncScheduler.handle(task, delay);
