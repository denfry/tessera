@@ -1,6 +1,7 @@
 package io.papermc.paper.log;
 
 import java.util.Locale;
+import java.util.Map;
 
 // Tessera start - console log style
 /**
@@ -14,6 +15,8 @@ public final class TesseraLogStyle {
     public static final String ENV = "TESSERA_LOG_STYLE";
     public static final String CLASSIC = "classic";
     public static final String PRETTY = "pretty";
+    // TerminalConsoleAppender.ANSI_OVERRIDE_PROPERTY, kept as a string so this class does not load TCA early
+    static final String ANSI_PROPERTY = "terminal.ansi";
 
     private TesseraLogStyle() {
     }
@@ -24,6 +27,29 @@ public final class TesseraLogStyle {
             raw = System.getenv(ENV);
         }
         System.setProperty(PROPERTY, resolve(raw));
+        if (System.getProperty(ANSI_PROPERTY) == null) {
+            final Boolean ansi = ansiFromEnv(System.getenv());
+            if (ansi != null) {
+                System.setProperty(ANSI_PROPERTY, ansi.toString());
+            }
+        }
+    }
+
+    /**
+     * Color on or off from the environment for {@code terminal.ansi}, which TerminalConsoleAppender reads: {@code NO_COLOR}
+     * (no-color.org) turns it off, {@code FORCE_COLOR} turns it on without a TTY, and so does a Pterodactyl container
+     * ({@code P_SERVER_UUID}): its console renders ANSI but is not a TTY. {@code null} leaves the TTY check to TCA.
+     */
+    static Boolean ansiFromEnv(final Map<String, String> env) {
+        final String noColor = env.get("NO_COLOR");
+        if (noColor != null && !noColor.isEmpty()) {
+            return false;
+        }
+        final String forceColor = env.get("FORCE_COLOR");
+        if (forceColor != null) {
+            return !forceColor.equals("0") && !forceColor.equalsIgnoreCase("false");
+        }
+        return env.containsKey("P_SERVER_UUID") ? Boolean.TRUE : null;
     }
 
     static String resolve(final String raw) {
