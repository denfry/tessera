From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Mon, 2 Nov 2026 08:32:05 +0300
Subject: [PATCH] Do not write to the recipe maps directly

The maps are replaced on every change, so a direct write would be lost and
would race with the regions reading them.

diff --git a/src/main/java/io/papermc/paper/potion/PaperPotionBrewer.java b/src/main/java/io/papermc/paper/potion/PaperPotionBrewer.java
index 4e998a422c8420134e90f37a77815a8cfd37831d..6d3191e979947e3a3843fc1b7d2c9c713bf95ee5 100644
--- a/src/main/java/io/papermc/paper/potion/PaperPotionBrewer.java
+++ b/src/main/java/io/papermc/paper/potion/PaperPotionBrewer.java
@@ -53,11 +53,8 @@ public class PaperPotionBrewer implements PotionBrewer {
         final RecipeManager recipeManager = this.server.getRecipeManager();
         final RegistryAccess registryAccess = this.server.registryAccess();
 
-        final Collection<RecipeHolder<BrewingRecipe>> brewingRecipes = recipeManager.recipes.byType(RecipeType.BREWING);
-
         // Completely clear brewing recipes.
-        brewingRecipes.forEach(recipe -> recipeManager.recipes.byKey.remove(recipe.id()));
-        brewingRecipes.clear();
+        recipeManager.recipes.removeRecipes(RecipeType.BREWING); // Tessera - regions read recipes while plugins change them
 
         // Restore recipe manager state for brewing from registries.
         registryAccess.get(Registries.RECIPE)
diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/RecipeIterator.java b/src/main/java/org/bukkit/craftbukkit/inventory/RecipeIterator.java
index b7b342f77eb3b296e459dafd72f5f0214e244174..d07b7324d2fc3be508d221ee146c5a6d594dfbe5 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/RecipeIterator.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/RecipeIterator.java
@@ -28,8 +28,7 @@ public class RecipeIterator implements Iterator<Recipe> {
 
     @Override
     public void remove() {
-        MinecraftServer.getServer().getRecipeManager().recipes.byKey.remove(this.currentRecipe.id());
-        this.recipes.remove();
+        MinecraftServer.getServer().getRecipeManager().recipes.removeRecipe(this.currentRecipe.id()); // Tessera - regions read recipes while plugins change them, this iterator walks a snapshot
         MinecraftServer.getServer().getRecipeManager().finalizeRecipeLoading();
         MinecraftServer.getServer().getPlayerList().reloadRecipes();
     }
