diff --git a/src/main/java/io/papermc/paper/threadedregions/TesseraTrackerPool.java b/src/main/java/io/papermc/paper/threadedregions/TesseraTrackerPool.java
new file mode 100644
index 0000000000000000000000000000000000000000..060f1d6b3ff3ff92e3ab626445ecd0314dde47e1
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/TesseraTrackerPool.java
@@ -0,0 +1,85 @@
+package io.papermc.paper.threadedregions;
+
+import com.mojang.logging.LogUtils;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.IntConsumer;
+import org.slf4j.Logger;
+
+/**
+ * Pool that helps a region thread with read-only entity tracker work. The region thread works through the batches
+ * itself, so a busy pool slows nothing down, and it returns only when no worker is still inside a batch.
+ */
+public final class TesseraTrackerPool {
+
+    private static final Logger LOGGER = LogUtils.getClassLogger();
+    private static final AtomicBoolean FAILURE_REPORTED = new AtomicBoolean();
+    private static final int THREADS = threads();
+    private static final AtomicInteger THREAD_ID = new AtomicInteger();
+    private static final ExecutorService POOL = Executors.newFixedThreadPool(THREADS, task -> {
+        final Thread thread = new Thread(task, "Tessera Tracker Thread #" + THREAD_ID.incrementAndGet());
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    private TesseraTrackerPool() {
+    }
+
+    private static int threads() {
+        final int configured = TesseraCompat.asyncEntityTrackerThreads();
+        return configured > 0 ? configured : Math.max(1, Math.min(4, Runtime.getRuntime().availableProcessors() / 4));
+    }
+
+    /**
+     * Runs {@code action} for every index below {@code count}, in batches, on the calling thread and the pool.
+     * {@code action} must not throw.
+     */
+    public static void forEach(final int count, final int batchSize, final IntConsumer action) {
+        final AtomicInteger nextIndex = new AtomicInteger();
+        final AtomicInteger workers = new AtomicInteger(); // workers inside a batch; negative once the call is over
+        final Runnable batches = () -> {
+            int start;
+            while ((start = nextIndex.getAndAdd(batchSize)) < count) {
+                for (int i = start, end = Math.min(count, start + batchSize); i < end; ++i) {
+                    action.accept(i);
+                }
+            }
+        };
+
+        final int helpers = Math.min(THREADS, (count - 1) / batchSize);
+        for (int i = 0; i < helpers; ++i) {
+            POOL.execute(() -> {
+                int current;
+                do {
+                    current = workers.get();
+                    if (current < 0) {
+                        return; // queued behind other regions until the work was already done
+                    }
+                } while (!workers.compareAndSet(current, current + 1));
+                try {
+                    batches.run();
+                } finally {
+                    workers.decrementAndGet();
+                }
+            });
+        }
+
+        batches.run();
+
+        workers.addAndGet(Integer.MIN_VALUE);
+        while (workers.get() != Integer.MIN_VALUE) {
+            Thread.onSpinWait(); // batches are short, and parking can take milliseconds on Windows
+        }
+    }
+
+    /**
+     * Logs the first failed check. The entity falls back to the full update on the region thread.
+     */
+    public static void reportFailure(final RuntimeException ex) {
+        if (FAILURE_REPORTED.compareAndSet(false, true)) {
+            LOGGER.error("Entity tracker check failed off the region thread, further failures are not logged", ex);
+        }
+    }
+}
