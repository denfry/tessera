index 0000000000000000000000000000000000000000..8f8d09d23377cd304dd441d15b5ddebcc0d676e7
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/TesseraThreadCheckHint.java
@@ -0,0 +1,105 @@
+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import io.papermc.paper.plugin.provider.classloader.ConfiguredPluginClassLoader;
+import org.bukkit.plugin.Plugin;
+
+/**
+ * Explains a failed thread check in the log: which plugin made the call, on which kind of thread, and which Folia
+ * API to use instead. The exception itself keeps the upstream message.
+ */
+public final class TesseraThreadCheckHint {
+
+    public enum Target {
+        /** A block, chunk or area of a world. */
+        WORLD,
+        /** An entity. */
+        ENTITY,
+        /** No position known. */
+        UNKNOWN
+    }
+
+    private static final StackWalker STACK_WALKER = StackWalker.getInstance(StackWalker.Option.RETAIN_CLASS_REFERENCE);
+    private static final String ISSUES = "https://github.com/denfry/tessera/issues";
+
+    private TesseraThreadCheckHint() {
+    }
+
+    private record Caller(Plugin plugin, String method) {
+    }
+
+    private static Caller findCaller() {
+        return STACK_WALKER.walk(frames -> {
+            StackWalker.StackFrame callee = null;
+            for (final StackWalker.StackFrame frame : (Iterable<StackWalker.StackFrame>) frames::iterator) {
+                if (frame.getDeclaringClass().getClassLoader() instanceof ConfiguredPluginClassLoader loader && loader.getPlugin() != null) {
+                    final String method = callee == null ? "?" : simpleName(callee.getClassName()) + "." + callee.getMethodName();
+                    return new Caller(loader.getPlugin(), method);
+                }
+                if (frame.getDeclaringClass() != TesseraThreadCheckHint.class && frame.getDeclaringClass() != TickThread.class) {
+                    callee = frame;
+                }
+            }
+            return null;
+        });
+    }
+
+    private static String simpleName(final String className) {
+        return className.substring(className.lastIndexOf('.') + 1);
+    }
+
+    private static String threadKind() {
+        if (RegionizedServer.isGlobalTickThread()) {
+            return "the global region thread";
+        }
+        if (TickRegionScheduler.getCurrentRegion() != null) {
+            return "the thread of another region";
+        }
+        return "a thread that owns no region (" + Thread.currentThread().getName() + ")";
+    }
+
+    private static String advice(final Target target) {
+        return switch (target) {
+            case WORLD -> " Blocks and chunks belong to the region that owns their location: run the code with"
+                + " Bukkit.getRegionScheduler().run(plugin, location, task), and load chunks with World#getChunkAtAsync.";
+            case ENTITY -> " An entity belongs to the region it is in: run the code with entity.getScheduler().run(plugin, task, null),"
+                + " and move entities with Entity#teleportAsync.";
+            case UNKNOWN -> " Run it on the thread that owns the state: Bukkit.getGlobalRegionScheduler() for server-wide state,"
+                + " the region or entity scheduler for world state.";
+        };
+    }
+
+    /**
+     * Returns text to append to the log line of a failed thread check, starting with a line break. Never throws.
+     */
+    public static String hint(final Target target) {
+        try {
+            final Caller caller = findCaller();
+            final StringBuilder builder = new StringBuilder("\nTessera: ");
+            if (caller == null) {
+                builder.append("no plugin on the stack, called on ").append(threadKind()).append('.')
+                    .append(" If this is not caused by a plugin, report it with this log: ").append(ISSUES);
+                return builder.toString();
+            }
+            final Plugin plugin = caller.plugin();
+            final boolean compat = TesseraCompat.isCompat(plugin);
+            builder.append(plugin.getName()).append(' ').append(plugin.getPluginMeta().getVersion())
+                .append(compat ? " (compatibility mode)" : " (supports Folia)")
+                .append(" called ").append(caller.method()).append(" on ").append(threadKind()).append('.');
+            if (compat) {
+                if (RegionizedServer.isGlobalTickThread()) {
+                    builder.append(" Region loans did not help here: the call is outside a BukkitScheduler or global task or command of the plugin, or the region could not be taken in time.");
+                } else {
+                    builder.append(" Plugins in compatibility mode borrow regions only from sync scheduler tasks and commands, not from event handlers or async tasks.");
+                }
+                builder.append(" See /tessera compat ").append(plugin.getName()).append('.');
+            } else {
+                builder.append(advice(target)).append(" This is a bug in the plugin; report it to its author.");
+            }
+            return builder.toString();
+        } catch (final Throwable ignored) {
+            // the hint must never replace the exception of the thread check
+            return "";
+        }
+    }
+}
