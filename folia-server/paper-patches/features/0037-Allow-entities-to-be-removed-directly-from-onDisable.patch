From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Sun, 1 Nov 2026 09:09:33 +0300
Subject: [PATCH] Allow entities to be removed directly from onDisable

Scheduler tasks from onDisable already run owning their region, but a
plugin that calls Entity#remove directly has no region on the shutdown
thread: removal failed with a NullPointerException in the entity
callbacks, and the armour stand or camera entity stayed in the world.
Run the removal the same way, owning the region of the entity.

diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index e638a094b0bd8b5447bc7a7d91b52f2014ca1f32..26be4bb20caf029c8433bcf09a8b398ade2d0d26 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -507,6 +507,12 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
 
     @Override
     public void remove() {
+        // Tessera start - a direct remove from onDisable has no region to run on
+        if (io.papermc.paper.threadedregions.TickRegionScheduler.getCurrentRegion() == null
+            && io.papermc.paper.threadedregions.RegionShutdownThread.runOwnedDuringShutdown((net.minecraft.server.level.ServerLevel) this.entity.level(), this.entity.chunkPosition().x(), this.entity.chunkPosition().z(), this::remove)) {
+            return;
+        }
+        // Tessera end - a direct remove from onDisable has no region to run on
         this.entity.pluginRemoved = true;
         this.entity.discard(this.getHandle().generation ? null : EntityRemoveEvent.Cause.PLUGIN);
     }
