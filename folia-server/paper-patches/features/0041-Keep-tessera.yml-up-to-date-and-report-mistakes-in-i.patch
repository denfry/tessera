diff --git a/src/main/java/io/papermc/paper/configuration/TesseraConfigFile.java b/src/main/java/io/papermc/paper/configuration/TesseraConfigFile.java
new file mode 100644
index 0000000000000000000000000000000000000000..db4778059398dafafb786c0f836212a497db2439
--- /dev/null
+++ b/src/main/java/io/papermc/paper/configuration/TesseraConfigFile.java
@@ -0,0 +1,438 @@
+package io.papermc.paper.configuration;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+import org.slf4j.Logger;
+import org.yaml.snakeyaml.DumperOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.error.YAMLException;
+
+// Tessera start - self-updating tessera.yml
+/**
+ * The options of {@code tessera.yml}, with their defaults and comments.
+ * <p>
+ * Loading checks every value against its option and warns about values of the wrong type, numbers out of range
+ * and unknown keys (with the closest known key, for typos); such values fall back to the default. Options missing
+ * from the file, for example ones added by a newer build, are written into it with their comments, so the file
+ * always lists everything that can be set. The rewrite keeps the values, also wrong ones and unknown keys, but not
+ * comments of the admin; the previous file is kept next to it as {@code tessera.yml.old}.
+ */
+public final class TesseraConfigFile {
+
+    public enum Kind { BOOLEAN, INT, DOUBLE, STRING, STRING_LIST }
+
+    /**
+     * @param restart whether a changed value takes effect only after a restart, for {@code /tessera reload}
+     */
+    public record Option(String path, Kind kind, Object def, double min, double max, List<String> choices,
+                         boolean restart, List<String> comment) {
+    }
+
+    public record Result(Map<String, Object> values, List<String> problems, List<String> added, boolean written) {
+    }
+
+    private static final Pattern PLAIN = Pattern.compile("[A-Za-z][A-Za-z0-9_./-]*");
+    private static final Set<String> RESERVED = Set.of("true", "false", "yes", "no", "on", "off", "null", "y", "n");
+
+    private final List<String> header;
+    private final Map<String, List<String>> groupComments = new LinkedHashMap<>();
+    private final Map<String, Option> options = new LinkedHashMap<>();
+
+    public TesseraConfigFile(final String header) {
+        this.header = lines(header);
+    }
+
+    public TesseraConfigFile group(final String path, final String comment) {
+        this.groupComments.put(path, lines(comment));
+        return this;
+    }
+
+    public TesseraConfigFile bool(final String path, final boolean def, final boolean restart, final String comment) {
+        return this.add(new Option(path, Kind.BOOLEAN, def, 0, 0, List.of(), restart, lines(comment)));
+    }
+
+    public TesseraConfigFile integer(final String path, final int def, final int min, final int max, final boolean restart, final String comment) {
+        return this.add(new Option(path, Kind.INT, def, min, max, List.of(), restart, lines(comment)));
+    }
+
+    public TesseraConfigFile decimal(final String path, final double def, final double min, final double max, final boolean restart, final String comment) {
+        return this.add(new Option(path, Kind.DOUBLE, def, min, max, List.of(), restart, lines(comment)));
+    }
+
+    public TesseraConfigFile choice(final String path, final String def, final List<String> choices, final boolean restart, final String comment) {
+        return this.add(new Option(path, Kind.STRING, def, 0, 0, List.copyOf(choices), restart, lines(comment)));
+    }
+
+    public TesseraConfigFile text(final String path, final String def, final boolean restart, final String comment) {
+        return this.add(new Option(path, Kind.STRING, def, 0, 0, List.of(), restart, lines(comment)));
+    }
+
+    public TesseraConfigFile strings(final String path, final List<String> def, final boolean restart, final String comment) {
+        return this.add(new Option(path, Kind.STRING_LIST, List.copyOf(def), 0, 0, List.of(), restart, lines(comment)));
+    }
+
+    private TesseraConfigFile add(final Option option) {
+        this.options.put(option.path(), option);
+        return this;
+    }
+
+    public Map<String, Option> options() {
+        return this.options;
+    }
+
+    public Map<String, Object> defaults() {
+        final Map<String, Object> values = new LinkedHashMap<>();
+        this.options.values().forEach(option -> values.put(option.path(), option.def()));
+        return values;
+    }
+
+    /**
+     * Reads the file, creating it or adding missing options to it. On a file that is not valid YAML every option
+     * keeps its default and the file is left alone.
+     */
+    public Result load(final Path file, final Logger logger) {
+        final List<String> problems = new ArrayList<>();
+        if (Files.notExists(file)) {
+            try {
+                if (file.getParent() != null) {
+                    Files.createDirectories(file.getParent());
+                }
+                Files.writeString(file, this.render(Map.of()));
+                return new Result(this.defaults(), problems, List.of(), true);
+            } catch (final IOException ex) {
+                logger.error("Could not create {}, using the defaults", file, ex);
+                return new Result(this.defaults(), problems, List.of(), false);
+            }
+        }
+
+        final Object root;
+        try (final Reader reader = Files.newBufferedReader(file)) {
+            root = new Yaml().load(reader);
+        } catch (final IOException | YAMLException ex) {
+            logger.error("Could not read {}, using the defaults for every option: {}", file, ex.getMessage());
+            return new Result(this.defaults(), problems, List.of(), false);
+        }
+        final Map<?, ?> user = root instanceof Map<?, ?> map ? map : Map.of();
+        if (root != null && !(root instanceof Map<?, ?>)) {
+            problems.add("the file is not a list of options, using the defaults");
+        }
+
+        final Map<String, Object> values = new LinkedHashMap<>();
+        final List<String> added = new ArrayList<>();
+        for (final Option option : this.options.values()) {
+            final Lookup raw = lookup(user, option.path());
+            if (!raw.found()) {
+                added.add(option.path());
+                values.put(option.path(), option.def());
+                continue;
+            }
+            values.put(option.path(), this.convert(option, raw.value(), problems));
+        }
+        this.findUnknown(user, "", problems);
+
+        boolean written = false;
+        if (!added.isEmpty() && (root == null || root instanceof Map<?, ?>)) {
+            try {
+                Files.copy(file, file.resolveSibling(file.getFileName() + ".old"), StandardCopyOption.REPLACE_EXISTING);
+                Files.writeString(file, this.render(user));
+                written = true;
+            } catch (final IOException ex) {
+                logger.error("Could not add the new options to {}", file, ex);
+            }
+        }
+        return new Result(values, problems, added, written);
+    }
+
+    private Object convert(final Option option, final Object raw, final List<String> problems) {
+        final String path = option.path();
+        switch (option.kind()) {
+            case BOOLEAN -> {
+                if (raw instanceof Boolean bool) {
+                    return bool;
+                }
+                if (raw instanceof String string && (string.equalsIgnoreCase("true") || string.equalsIgnoreCase("false"))) {
+                    return Boolean.parseBoolean(string);
+                }
+                problems.add(path + ": expected true or false, got " + describe(raw) + "; using " + option.def());
+                return option.def();
+            }
+            case INT, DOUBLE -> {
+                Number number = raw instanceof Number n ? n : null;
+                if (number == null && raw instanceof String string) {
+                    try {
+                        number = Double.parseDouble(string.trim());
+                    } catch (final NumberFormatException ignored) {
+                        // reported below
+                    }
+                }
+                if (number == null || option.kind() == Kind.INT && number.doubleValue() != Math.rint(number.doubleValue())) {
+                    problems.add(path + ": expected " + (option.kind() == Kind.INT ? "a whole number" : "a number")
+                        + ", got " + describe(raw) + "; using " + option.def());
+                    return option.def();
+                }
+                double value = number.doubleValue();
+                if (value < option.min() || value > option.max()) {
+                    final double clamped = Math.max(option.min(), Math.min(option.max(), value));
+                    problems.add(path + ": " + format(number) + " is out of range " + format(option.min()) + ".."
+                        + format(option.max()) + "; using " + format(clamped));
+                    value = clamped;
+                }
+                return option.kind() == Kind.INT ? (Object) (int) value : (Object) value;
+            }
+            case STRING -> {
+                if (raw instanceof Map<?, ?> || raw instanceof List<?>) {
+                    problems.add(path + ": expected a single value, got " + describe(raw) + "; using " + option.def());
+                    return option.def();
+                }
+                final String value = raw == null ? "" : raw.toString().trim();
+                if (option.choices().isEmpty()) {
+                    return raw == null ? option.def() : raw.toString();
+                }
+                for (final String choice : option.choices()) {
+                    if (choice.equalsIgnoreCase(value)) {
+                        return choice;
+                    }
+                }
+                problems.add(path + ": expected one of " + String.join(", ", option.choices()) + ", got " + describe(raw)
+                    + "; using " + option.def());
+                return option.def();
+            }
+            case STRING_LIST -> {
+                if (raw == null) {
+                    return List.of();
+                }
+                if (raw instanceof List<?> list) {
+                    final List<String> strings = new ArrayList<>();
+                    for (final Object entry : list) {
+                        if (entry instanceof Map<?, ?> || entry instanceof List<?>) {
+                            problems.add(path + ": expected a list of values, an entry is " + describe(entry) + "; skipped");
+                        } else if (entry != null) {
+                            strings.add(entry.toString());
+                        }
+                    }
+                    return List.copyOf(strings);
+                }
+                if (raw instanceof Map<?, ?>) {
+                    problems.add(path + ": expected a list, got " + describe(raw) + "; using " + option.def());
+                    return option.def();
+                }
+                return List.of(raw.toString());
+            }
+        }
+        throw new IllegalStateException(option.kind().name());
+    }
+
+    private void findUnknown(final Map<?, ?> map, final String prefix, final List<String> problems) {
+        for (final Map.Entry<?, ?> entry : map.entrySet()) {
+            final String path = prefix + entry.getKey();
+            if (this.options.containsKey(path)) {
+                continue;
+            }
+            if (this.isGroup(path)) {
+                if (entry.getValue() instanceof Map<?, ?> child) {
+                    this.findUnknown(child, path + ".", problems);
+                } else {
+                    problems.add(path + ": expected a section of options, got " + describe(entry.getValue()) + "; using the defaults");
+                }
+                continue;
+            }
+            final String closest = this.closest(prefix, path);
+            problems.add("unknown option " + path + (closest == null ? "" : " (did you mean " + closest + "?)") + ", ignored");
+        }
+    }
+
+    private boolean isGroup(final String path) {
+        final String prefix = path + ".";
+        for (final String option : this.options.keySet()) {
+            if (option.startsWith(prefix)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private String closest(final String prefix, final String path) {
+        String best = null;
+        int bestDistance = Integer.MAX_VALUE;
+        final Set<String> candidates = new LinkedHashSet<>(this.options.keySet());
+        for (final String option : this.options.keySet()) {
+            for (int dot = option.indexOf('.'); dot > 0; dot = option.indexOf('.', dot + 1)) {
+                candidates.add(option.substring(0, dot));
+            }
+        }
+        final String key = path.substring(prefix.length()).toLowerCase(Locale.ROOT);
+        for (final String candidate : candidates) {
+            // a key in the same section, or the same key in another section
+            final boolean sameSection = candidate.startsWith(prefix) && candidate.indexOf('.', prefix.length()) < 0;
+            final String candidateKey = candidate.substring(candidate.lastIndexOf('.') + 1);
+            final int distance = sameSection ? distance(key, candidateKey) : candidateKey.equalsIgnoreCase(key) ? 0 : Integer.MAX_VALUE;
+            if (distance < bestDistance) {
+                bestDistance = distance;
+                best = candidate;
+            }
+        }
+        return bestDistance <= Math.max(2, key.length() / 3) ? best : null;
+    }
+
+    static int distance(final String a, final String b) {
+        final int[] previous = new int[b.length() + 1];
+        final int[] current = new int[b.length() + 1];
+        for (int j = 0; j <= b.length(); ++j) {
+            previous[j] = j;
+        }
+        for (int i = 1; i <= a.length(); ++i) {
+            current[0] = i;
+            for (int j = 1; j <= b.length(); ++j) {
+                final int cost = a.charAt(i - 1) == b.charAt(j - 1) ? 0 : 1;
+                current[j] = Math.min(Math.min(current[j - 1] + 1, previous[j] + 1), previous[j - 1] + cost);
+            }
+            System.arraycopy(current, 0, previous, 0, current.length);
+        }
+        return previous[b.length()];
+    }
+
+    private record Lookup(boolean found, Object value) {
+    }
+
+    private static Lookup lookup(final Map<?, ?> root, final String path) {
+        Object node = root;
+        for (final String part : path.split("\\.")) {
+            if (!(node instanceof Map<?, ?> map) || !map.containsKey(part)) {
+                return new Lookup(false, null);
+            }
+            node = map.get(part);
+        }
+        return new Lookup(true, node);
+    }
+
+    /**
+     * The file with every option: the value from {@code user} where it has one, the default otherwise, and the
+     * unknown keys of {@code user} after the known ones of their section.
+     */
+    public String render(final Map<?, ?> user) {
+        final StringBuilder out = new StringBuilder();
+        for (final String line : this.header) {
+            out.append(line.isEmpty() ? "#" : "# " + line).append('\n');
+        }
+        this.renderGroup("", 0, user, out);
+        return out.toString();
+    }
+
+    private void renderGroup(final String prefix, final int indent, final Map<?, ?> user, final StringBuilder out) {
+        final String pad = " ".repeat(indent);
+        final Set<String> children = new LinkedHashSet<>();
+        for (final String path : this.options.keySet()) {
+            if (path.startsWith(prefix)) {
+                final int dot = path.indexOf('.', prefix.length());
+                children.add(dot < 0 ? path.substring(prefix.length()) : path.substring(prefix.length(), dot));
+            }
+        }
+        for (final String child : children) {
+            final String path = prefix + child;
+            final Option option = this.options.get(path);
+            final List<String> comment = option != null ? option.comment() : this.groupComments.getOrDefault(path, List.of());
+            if (indent == 0) {
+                out.append('\n');
+            }
+            for (final String line : comment) {
+                out.append(pad).append(line.isEmpty() ? "#" : "# " + line).append('\n');
+            }
+            final Object userValue = user.get(child);
+            if (option == null) {
+                out.append(pad).append(child).append(":\n");
+                this.renderGroup(path + ".", indent + 2, userValue instanceof Map<?, ?> map ? map : Map.of(), out);
+            } else {
+                final Object value = user.containsKey(child) ? userValue : option.def();
+                out.append(pad).append(child).append(':').append(renderValue(value, indent)).append('\n');
+            }
+        }
+        for (final Map.Entry<?, ?> entry : user.entrySet()) {
+            final String key = String.valueOf(entry.getKey());
+            if (!children.contains(key)) {
+                out.append(pad).append(scalar(key)).append(':').append(renderValue(entry.getValue(), indent)).append('\n');
+            }
+        }
+    }
+
+    private static String renderValue(final Object value, final int indent) {
+        if (value instanceof List<?> list) {
+            if (list.isEmpty()) {
+                return " []";
+            }
+            final StringBuilder out = new StringBuilder();
+            for (final Object entry : list) {
+                out.append('\n').append(" ".repeat(indent + 2)).append("- ").append(entry instanceof Map<?, ?> || entry instanceof List<?>
+                    ? dump(entry, indent + 4).stripLeading() : scalar(entry));
+            }
+            return out.toString();
+        }
+        if (value instanceof Map<?, ?> map) {
+            return map.isEmpty() ? " {}" : "\n" + dump(map, indent + 2).stripTrailing();
+        }
+        return " " + scalar(value);
+    }
+
+    private static String dump(final Object value, final int indent) {
+        final DumperOptions options = new DumperOptions();
+        options.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        options.setIndent(2);
+        final String pad = " ".repeat(indent);
+        final StringBuilder out = new StringBuilder();
+        for (final String line : new Yaml(options).dump(value).split("\n")) {
+            out.append(pad).append(line).append('\n');
+        }
+        return out.toString();
+    }
+
+    static String scalar(final Object value) {
+        if (value == null) {
+            return "null";
+        }
+        if (value instanceof Boolean || value instanceof Integer || value instanceof Long) {
+            return value.toString();
+        }
+        if (value instanceof Number number) {
+            return format(number);
+        }
+        final String string = value.toString();
+        if (PLAIN.matcher(string).matches() && !RESERVED.contains(string.toLowerCase(Locale.ROOT))) {
+            return string;
+        }
+        return "'" + string.replace("'", "''") + "'";
+    }
+
+    private static String format(final Number number) {
+        final double value = number.doubleValue();
+        return value == Math.rint(value) && Math.abs(value) < 1e15 ? Long.toString((long) value) : Double.toString(value);
+    }
+
+    private static String format(final double value) {
+        return format((Number) value);
+    }
+
+    private static String describe(final Object value) {
+        if (value instanceof Map<?, ?>) {
+            return "a section";
+        }
+        if (value instanceof List<?>) {
+            return "a list";
+        }
+        return value == null ? "nothing" : "'" + value + "'";
+    }
+
+    private static List<String> lines(final String text) {
+        return text == null || text.isEmpty() ? List.of() : List.of(text.stripTrailing().split("\n", -1));
+    }
+}
+// Tessera end - self-updating tessera.yml
