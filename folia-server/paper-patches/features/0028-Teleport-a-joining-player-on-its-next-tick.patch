From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <aseraw115@gmail.com>
Date: Fri, 30 Oct 2026 11:45:59 +0300
Subject: [PATCH] Teleport a joining player on its next tick


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index c1d4441f094f82c8184bee6a550533e101a00641..e638a094b0bd8b5447bc7a7d91b52f2014ca1f32 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1241,7 +1241,11 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
                 ret.complete(Boolean.FALSE);
             }
         };
-        if (org.bukkit.Bukkit.isOwnedByCurrentRegion(this)) {
+        // Tessera start - teleport a joining player on its next tick
+        // In PlayerJoinEvent the player is not in the chunk loader and the tracker yet (T-067)
+        final boolean joining = this.getHandle() instanceof net.minecraft.server.level.ServerPlayer player && player.suppressTrackerForLogin;
+        if (org.bukkit.Bukkit.isOwnedByCurrentRegion(this) && !joining) {
+        // Tessera end - teleport a joining player on its next tick
             run.accept(this.getHandle());
             return ret;
         }
