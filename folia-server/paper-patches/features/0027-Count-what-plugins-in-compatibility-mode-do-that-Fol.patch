diff --git a/src/main/java/io/papermc/paper/threadedregions/TesseraCompatReport.java b/src/main/java/io/papermc/paper/threadedregions/TesseraCompatReport.java
new file mode 100644
index 0000000000000000000000000000000000000000..934f1e78bd65636e5fa8e93953a7392ad3325e83
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/TesseraCompatReport.java
@@ -0,0 +1,189 @@
+package io.papermc.paper.threadedregions;
+
+import io.papermc.paper.plugin.provider.classloader.ConfiguredPluginClassLoader;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.LongAdder;
+import org.bukkit.plugin.Plugin;
+
+/**
+ * Counts what plugins in compatibility mode do that Folia does not allow: failed thread checks, and calls that
+ * Tessera handles in a different way than Paper (synchronous teleport, entities of the whole world). Each entry is
+ * a plugin, the API method it called and the thread it called it on, with the stack of the first call.
+ * <p>
+ * Nothing is counted on the paths that succeed anyway: entries are only added where the server would throw or has
+ * already walked the stack.
+ */
+public final class TesseraCompatReport {
+
+    public enum Kind {
+        /** A thread check failed and the call threw. */
+        FAILED,
+        /** A synchronous teleport, run through {@code teleportAsync} in the next tick of the entity. */
+        TELEPORT,
+        /** A list of the entities of a world, cut down to the region of the calling thread. */
+        REGION_ENTITIES
+    }
+
+    public enum Context {
+        GLOBAL, REGION, OTHER;
+
+        static Context current() {
+            if (RegionizedServer.isGlobalTickThread()) {
+                return GLOBAL;
+            }
+            return TickRegionScheduler.getCurrentRegion() != null ? REGION : OTHER;
+        }
+    }
+
+    public record Key(String plugin, Kind kind, Context context, String method) {
+    }
+
+    public static final class Entry {
+        private final LongAdder count = new LongAdder();
+        private final long firstSeen;
+        private final String thread;
+        private final String reason;
+        private final StackTraceElement[] stack;
+
+        private Entry(final String reason, final StackTraceElement[] stack) {
+            this.firstSeen = System.currentTimeMillis();
+            this.thread = Thread.currentThread().getName();
+            this.reason = reason;
+            this.stack = stack;
+        }
+
+        public long count() {
+            return this.count.sum();
+        }
+
+        public Instant firstSeen() {
+            return Instant.ofEpochMilli(this.firstSeen);
+        }
+
+        public String thread() {
+            return this.thread;
+        }
+
+        public String reason() {
+            return this.reason;
+        }
+
+        public StackTraceElement[] stack() {
+            return this.stack.clone();
+        }
+    }
+
+    private static final StackWalker STACK_WALKER = StackWalker.getInstance(StackWalker.Option.RETAIN_CLASS_REFERENCE);
+    private static final int MAX_ENTRIES = 1024;
+    private static final int MAX_STACK = 64;
+
+    private static final Map<Key, Entry> ENTRIES = new ConcurrentHashMap<>();
+    private static volatile long since = System.currentTimeMillis();
+
+    private TesseraCompatReport() {
+    }
+
+    private record Caller(Plugin plugin, String method) {
+    }
+
+    /**
+     * Finds the first frame of a plugin in compatibility mode on the stack and the method it called.
+     */
+    private static Caller findCaller() {
+        return STACK_WALKER.walk(frames -> {
+            StackWalker.StackFrame callee = null;
+            for (final StackWalker.StackFrame frame : (Iterable<StackWalker.StackFrame>) frames::iterator) {
+                if (frame.getDeclaringClass().getClassLoader() instanceof ConfiguredPluginClassLoader loader
+                    && loader.getPlugin() != null && TesseraCompat.isCompat(loader.getPlugin())) {
+                    final String method = callee == null ? "?" : simpleName(callee.getClassName()) + "." + callee.getMethodName();
+                    return new Caller(loader.getPlugin(), method);
+                }
+                if (frame.getDeclaringClass() != TesseraCompatReport.class) {
+                    callee = frame;
+                }
+            }
+            return null;
+        });
+    }
+
+    private static String simpleName(final String className) {
+        return className.substring(className.lastIndexOf('.') + 1);
+    }
+
+    /**
+     * Records a failed thread check if a plugin in compatibility mode is on the stack. Called right before the
+     * check throws.
+     */
+    public static void threadCheckFailed(final String reason) {
+        if (!TesseraCompat.enabled()) {
+            return;
+        }
+        try {
+            final Caller caller = findCaller();
+            if (caller != null) {
+                add(caller, Kind.FAILED, reason);
+            }
+        } catch (final Throwable ignored) {
+            // the report must never replace the exception of the thread check
+        }
+    }
+
+    /**
+     * Returns whether code of a plugin in compatibility mode is on the stack, and if so, records the call.
+     */
+    public static boolean calledByCompatPlugin(final Kind kind) {
+        if (!TesseraCompat.enabled()) {
+            return false;
+        }
+        final Caller caller = findCaller();
+        if (caller == null) {
+            return false;
+        }
+        add(caller, kind, null);
+        return true;
+    }
+
+    private static void add(final Caller caller, final Kind kind, final String reason) {
+        final Key key = new Key(caller.plugin().getName(), kind, Context.current(), caller.method());
+        Entry entry = ENTRIES.get(key);
+        if (entry == null) {
+            if (ENTRIES.size() >= MAX_ENTRIES) {
+                return;
+            }
+            final StackTraceElement[] stack = captureStack();
+            entry = ENTRIES.computeIfAbsent(key, k -> new Entry(reason, stack));
+        }
+        entry.count.increment();
+    }
+
+    private static StackTraceElement[] captureStack() {
+        return STACK_WALKER.walk(frames -> frames
+            .dropWhile(frame -> frame.getDeclaringClass() == TesseraCompatReport.class)
+            .limit(MAX_STACK)
+            .map(StackWalker.StackFrame::toStackTraceElement)
+            .toArray(StackTraceElement[]::new));
+    }
+
+    /**
+     * Returns the entries, the most frequent first.
+     */
+    public static List<Map.Entry<Key, Entry>> entries() {
+        final List<Map.Entry<Key, Entry>> list = new ArrayList<>(ENTRIES.entrySet());
+        list.sort(Comparator.<Map.Entry<Key, Entry>>comparingLong(e -> e.getValue().count()).reversed());
+        return list;
+    }
+
+    public static Instant since() {
+        return Instant.ofEpochMilli(since);
+    }
+
+    public static void reset() {
+        ENTRIES.clear();
+        since = System.currentTimeMillis();
+    }
+}
