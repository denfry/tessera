diff --git a/src/main/java/io/papermc/paper/command/TesseraCommand.java b/src/main/java/io/papermc/paper/command/TesseraCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..da2058db9f415f7ea6d3e16415b2f0a617922d60
--- /dev/null
+++ b/src/main/java/io/papermc/paper/command/TesseraCommand.java
@@ -0,0 +1,160 @@
+package io.papermc.paper.command;
+
+import io.papermc.paper.threadedregions.TesseraCompatReport;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+/**
+ * {@code /tessera compat}: what plugins in compatibility mode do that Folia does not allow.
+ */
+@DefaultQualifier(NonNull.class)
+public final class TesseraCommand extends Command {
+
+    private static final DateTimeFormatter TIME = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss").withZone(ZoneId.systemDefault());
+    private static final DateTimeFormatter FILE_TIME = DateTimeFormatter.ofPattern("yyyy-MM-dd_HH-mm-ss").withZone(ZoneId.systemDefault());
+    private static final int STACK_LINES = 12;
+
+    public TesseraCommand() {
+        super("tessera");
+        this.setUsage("/<command> compat [plugin|dump|reset]");
+        this.setDescription("Tessera tools: the compatibility mode report.");
+        this.setPermission("tessera.command.compat");
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String commandLabel, final String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+        if (args.length < 1 || !args[0].equalsIgnoreCase("compat")) {
+            sender.sendMessage(Component.text("Usage: /" + commandLabel + " compat [plugin|dump|reset]", NamedTextColor.RED));
+            return true;
+        }
+        if (args.length < 2) {
+            this.summary(sender);
+        } else if (args[1].equalsIgnoreCase("reset")) {
+            TesseraCompatReport.reset();
+            sender.sendMessage(Component.text("Compatibility report cleared.", NamedTextColor.GREEN));
+        } else if (args[1].equalsIgnoreCase("dump")) {
+            this.dump(sender);
+        } else {
+            this.plugin(sender, args[1]);
+        }
+        return true;
+    }
+
+    private static Map<String, List<Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry>>> byPlugin() {
+        final Map<String, List<Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry>>> map = new LinkedHashMap<>();
+        for (final Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry> entry : TesseraCompatReport.entries()) {
+            map.computeIfAbsent(entry.getKey().plugin(), k -> new ArrayList<>()).add(entry);
+        }
+        return map;
+    }
+
+    private static String line(final TesseraCompatReport.Key key, final TesseraCompatReport.Entry entry) {
+        return key.kind().name().toLowerCase(Locale.ROOT) + " " + key.context().name().toLowerCase(Locale.ROOT)
+            + " " + key.method() + " x" + entry.count();
+    }
+
+    private static NamedTextColor colour(final TesseraCompatReport.Kind kind) {
+        return kind == TesseraCompatReport.Kind.FAILED ? NamedTextColor.RED : NamedTextColor.YELLOW;
+    }
+
+    private void summary(final CommandSender sender) {
+        final Map<String, List<Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry>>> plugins = byPlugin();
+        sender.sendMessage(Component.text("Compatibility report since " + TIME.format(TesseraCompatReport.since())
+            + ": " + plugins.size() + " plugin(s)", NamedTextColor.GOLD));
+        if (plugins.isEmpty()) {
+            sender.sendMessage(Component.text("Nothing recorded.", NamedTextColor.GRAY));
+            return;
+        }
+        plugins.forEach((plugin, entries) -> {
+            sender.sendMessage(Component.text(plugin, NamedTextColor.AQUA));
+            for (final Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry> entry : entries) {
+                sender.sendMessage(Component.text("  " + line(entry.getKey(), entry.getValue()), colour(entry.getKey().kind())));
+            }
+        });
+        sender.sendMessage(Component.text("/tessera compat <plugin> shows the first stack, /tessera compat dump writes everything to a file.", NamedTextColor.GRAY));
+    }
+
+    private void plugin(final CommandSender sender, final String name) {
+        final List<Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry>> entries = byPlugin().entrySet().stream()
+            .filter(e -> e.getKey().equalsIgnoreCase(name))
+            .findFirst().map(Map.Entry::getValue).orElse(List.of());
+        if (entries.isEmpty()) {
+            sender.sendMessage(Component.text("Nothing recorded for " + name + ".", NamedTextColor.GRAY));
+            return;
+        }
+        for (final Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry> entry : entries) {
+            final List<String> lines = new ArrayList<>();
+            describe(entry.getKey(), entry.getValue(), STACK_LINES, lines);
+            sender.sendMessage(Component.text(lines.getFirst(), colour(entry.getKey().kind())));
+            for (final String line : lines.subList(1, lines.size())) {
+                sender.sendMessage(Component.text(line, NamedTextColor.GRAY));
+            }
+        }
+    }
+
+    private static void describe(final TesseraCompatReport.Key key, final TesseraCompatReport.Entry entry, final int stackLines, final List<String> out) {
+        out.add(line(key, entry));
+        out.add("  first: " + TIME.format(entry.firstSeen()) + " on " + entry.thread());
+        if (entry.reason() != null) {
+            out.add("  reason: " + entry.reason());
+        }
+        final StackTraceElement[] stack = entry.stack();
+        for (int i = 0; i < Math.min(stack.length, stackLines); ++i) {
+            out.add("    at " + stack[i]);
+        }
+        if (stack.length > stackLines) {
+            out.add("    ... " + (stack.length - stackLines) + " more");
+        }
+    }
+
+    private void dump(final CommandSender sender) {
+        final List<String> lines = new ArrayList<>();
+        lines.add("Tessera compatibility report, " + TIME.format(TesseraCompatReport.since()) + " - " + TIME.format(Instant.now()));
+        byPlugin().forEach((plugin, entries) -> {
+            lines.add("");
+            lines.add("== " + plugin);
+            for (final Map.Entry<TesseraCompatReport.Key, TesseraCompatReport.Entry> entry : entries) {
+                describe(entry.getKey(), entry.getValue(), Integer.MAX_VALUE, lines);
+            }
+        });
+        final Path file = Path.of("debug", "tessera-compat-" + FILE_TIME.format(Instant.now()) + ".txt");
+        try {
+            Files.createDirectories(file.getParent());
+            Files.write(file, lines);
+            sender.sendMessage(Component.text("Compatibility report written to " + file, NamedTextColor.GREEN));
+        } catch (final IOException ex) {
+            sender.sendMessage(Component.text("Could not write " + file + ": " + ex.getMessage(), NamedTextColor.RED));
+        }
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String alias, final String[] args) {
+        if (args.length == 1) {
+            return io.papermc.paper.threadedregions.commands.CommandUtil.getSortedList(List.of("compat"), args[0]);
+        }
+        if (args.length == 2 && args[0].equalsIgnoreCase("compat")) {
+            final List<String> options = new ArrayList<>(List.of("dump", "reset"));
+            options.addAll(byPlugin().keySet());
+            return io.papermc.paper.threadedregions.commands.CommandUtil.getSortedList(options, args[1]);
+        }
+        return List.of();
+    }
+}
