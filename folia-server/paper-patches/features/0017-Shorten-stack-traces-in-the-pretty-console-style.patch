-                                          pattern="%tesseraStyle{%d{HH:mm:ss}}{time} %tesseraStyle{%-5level}{level} %tesseraStyle{%notEmpty{[%X{tessera.region}] }}{dim}%highlightError{%msg%n%xEx{full}}" />
+                                          pattern="%tesseraStyle{%d{HH:mm:ss}}{time} %tesseraStyle{%-5level}{level} %tesseraStyle{%notEmpty{[%X{tessera.region}] }}{dim}%highlightError{%msg}%n%tesseraEx" />
                         </LoggerNamePatternSelector>
                     </PatternLayout>
                 </TerminalConsole>
