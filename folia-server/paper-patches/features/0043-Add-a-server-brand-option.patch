From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Mon, 2 Nov 2026 15:35:48 +0300
Subject: [PATCH] Add a server brand option

branding.server-brand in tessera.yml sets the name clients show in the F3 screen and, with the version, in the server list for an incompatible client. & color codes work. Empty keeps the build's name; nothing else that uses the server mod name, such as crash reports and the modded flag of worlds, changes.

diff --git a/src/main/java/com/destroystokyo/paper/network/PaperServerListPingEventImpl.java b/src/main/java/com/destroystokyo/paper/network/PaperServerListPingEventImpl.java
index 13b03dab807c5d83e086993af705e1d9a2676b4d..80c7769c7f593e575444eedb3b7b2d838ccd6207 100644
--- a/src/main/java/com/destroystokyo/paper/network/PaperServerListPingEventImpl.java
+++ b/src/main/java/com/destroystokyo/paper/network/PaperServerListPingEventImpl.java
@@ -14,7 +14,7 @@ class PaperServerListPingEventImpl extends PaperServerListPingEvent {
 
     PaperServerListPingEventImpl(MinecraftServer server, StatusClient client, int protocolVersion, @Nullable CachedServerIcon icon) {
         super(client, server.motd(), server.getPlayerCount(), server.getMaxPlayers(),
-                server.getServerModName() + ' ' + server.getServerVersion(), protocolVersion, icon);
+                io.papermc.paper.threadedregions.TesseraCompat.serverBrand(server.getServerModName()) + ' ' + server.getServerVersion(), protocolVersion, icon); // Tessera - server brand option
         this.server = server;
     }
 
diff --git a/src/main/java/io/papermc/paper/log/TesseraBanner.java b/src/main/java/io/papermc/paper/log/TesseraBanner.java
index 17391494e5f86b92fa930929cb18288ff30548d1..cee58d9362b6f5c58cfb52f4db109c42f167a47b 100644
--- a/src/main/java/io/papermc/paper/log/TesseraBanner.java
+++ b/src/main/java/io/papermc/paper/log/TesseraBanner.java
@@ -29,7 +29,7 @@ public final class TesseraBanner {
         "&3  |_|  |___||___/|___/|___||_|_\\/_/ \\_\\"
     );
     public static final List<String> DEFAULT_LINES = List.of(
-        "&f{brand} &7{version} &8| &7Minecraft &f{minecraft}",
+        "&f{brand} &7{version} &8| &7Minecraft &f{minecraft}", // Tessera - server brand option
         "&7Java {java} &8| &7{cpus} CPU threads &8| &7{memory} max heap",
         ""
     );
@@ -67,12 +67,17 @@ public final class TesseraBanner {
 
     private static Map<String, String> placeholders() {
         final ServerBuildInfo build = ServerBuildInfo.buildInfo();
+        // Tessera start - server brand option
+        final Object configured = TesseraCompat.value("branding.server-brand");
+        final String brand = configured instanceof String string && !string.isBlank() ? string : build.brandName();
+        // Tessera end - server brand option
         final long maxMemory = Runtime.getRuntime().maxMemory();
         final String memory = maxMemory >= 1L << 30
             ? String.format(Locale.ROOT, "%.1f GB", maxMemory / (double) (1L << 30))
             : (maxMemory >> 20) + " MB";
         return Map.of(
-            "{brand}", build.brandName(),
+            "{brand}", brand, // Tessera - server brand option
+            "{core}", build.brandName(), // Tessera - server brand option
             "{version}", build.asString(ServerBuildInfo.StringRepresentation.VERSION_SIMPLE),
             "{minecraft}", SharedConstants.getCurrentVersion().name(),
             "{java}", System.getProperty("java.version"),
diff --git a/src/main/java/io/papermc/paper/threadedregions/TesseraCompat.java b/src/main/java/io/papermc/paper/threadedregions/TesseraCompat.java
index c8f5c8b94e533b9c409a22ed37e5853ab355a54f..cdaa84b7af35b68ed8f602b3c9675994b8f640fe 100644
--- a/src/main/java/io/papermc/paper/threadedregions/TesseraCompat.java
+++ b/src/main/java/io/papermc/paper/threadedregions/TesseraCompat.java
@@ -81,11 +81,19 @@ public final class TesseraCompat {
             The logo and lines printed to the console at startup. Put your own ASCII art into logo to brand
             the console; one entry per line, in single quotes. Colors: &0-&9 and &a-&f as in Minecraft,
             &l bold, &o italic, &n underline, &r reset, &#rrggbb for terminals with true color.
-            Placeholders in both lists: {brand} {version} {minecraft} {java} {os} {cpus} {memory}.""")
+            Placeholders in both lists: {brand} (branding.server-brand, or the build's name) {core} (the
+            build's name) {version} {minecraft} {java} {os} {cpus} {memory}.""") // Tessera - server brand option
         .bool("console.banner.enabled", true, true, "")
         .strings("console.banner.logo", io.papermc.paper.log.TesseraBanner.DEFAULT_LOGO, true, "")
-        .strings("console.banner.lines", io.papermc.paper.log.TesseraBanner.DEFAULT_LINES, true, "");
+        .strings("console.banner.lines", io.papermc.paper.log.TesseraBanner.DEFAULT_LINES, true, "")
         // Tessera end - console banner
+        // Tessera start - server brand option
+        .group("branding", "")
+        .text("branding.server-brand", "", false, """
+            The server name players see in the F3 screen and, next to the version, in the server list when
+            their client is too old or too new. Empty keeps the build's own name. & color codes work, for
+            example '&6My&fServer'. Applies to players who join after a reload; a proxy may replace it.""");
+        // Tessera end - server brand option
 
     private static volatile Path configFile;
     private static volatile Map<String, Object> values = CONFIG.defaults();
@@ -198,6 +206,19 @@ public final class TesseraCompat {
         return report;
     }
 
+    // Tessera start - server brand option
+    /**
+     * The brand sent to clients: {@code branding.server-brand}, or {@code fallback} when it is empty.
+     */
+    public static String serverBrand(final String fallback) {
+        final Object brand = values.get("branding.server-brand");
+        if (!(brand instanceof String string) || string.isBlank()) {
+            return fallback;
+        }
+        return string.replaceAll("&([0-9a-fk-orA-FK-OR])", "\u00A7$1");
+    }
+    // Tessera end - server brand option
+
     /**
      * The value in effect of an option of {@code tessera.yml}.
      */
