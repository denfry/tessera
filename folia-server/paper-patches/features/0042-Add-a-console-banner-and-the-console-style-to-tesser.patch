diff --git a/src/main/java/io/papermc/paper/log/TesseraBanner.java b/src/main/java/io/papermc/paper/log/TesseraBanner.java
new file mode 100644
index 0000000000000000000000000000000000000000..17391494e5f86b92fa930929cb18288ff30548d1
--- /dev/null
+++ b/src/main/java/io/papermc/paper/log/TesseraBanner.java
@@ -0,0 +1,132 @@
+package io.papermc.paper.log;
+
+import io.papermc.paper.ServerBuildInfo;
+import io.papermc.paper.threadedregions.TesseraCompat;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import net.minecraft.SharedConstants;
+import net.minecrell.terminalconsole.TerminalConsoleAppender;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+// Tessera start - console banner
+/**
+ * The logo and lines printed to the console at startup, from {@code console.banner} in {@code tessera.yml}.
+ * <p>
+ * Lines go through the {@value #LOGGER_NAME} logger, which {@code log4j2.xml} prints to the console without the time
+ * and level, and to the log file with them. Color codes are {@code &0}-{@code &f}, {@code &l}, {@code &o},
+ * {@code &n}, {@code &r} and {@code &#rrggbb}; they become ANSI colors in a terminal that supports them and are
+ * dropped otherwise.
+ */
+public final class TesseraBanner {
+
+    public static final String LOGGER_NAME = "TesseraBanner";
+    public static final List<String> DEFAULT_LOGO = List.of(
+        "&b _____  ___  ___  ___  ___  ___    _   ",
+        "&b|_   _|| __|/ __|/ __|| __|| _ \\  /_\\  ",
+        "&3  | |  | _| \\__ \\\\__ \\| _| |   / / _ \\ ",
+        "&3  |_|  |___||___/|___/|___||_|_\\/_/ \\_\\"
+    );
+    public static final List<String> DEFAULT_LINES = List.of(
+        "&f{brand} &7{version} &8| &7Minecraft &f{minecraft}",
+        "&7Java {java} &8| &7{cpus} CPU threads &8| &7{memory} max heap",
+        ""
+    );
+
+    private static final Map<Character, String> CODES = Map.ofEntries(
+        Map.entry('0', "30"), Map.entry('1', "34"), Map.entry('2', "32"), Map.entry('3', "36"),
+        Map.entry('4', "31"), Map.entry('5', "35"), Map.entry('6', "33"), Map.entry('7', "37"),
+        Map.entry('8', "90"), Map.entry('9', "94"), Map.entry('a', "92"), Map.entry('b', "96"),
+        Map.entry('c', "91"), Map.entry('d', "95"), Map.entry('e', "93"), Map.entry('f', "97"),
+        Map.entry('l', "1"), Map.entry('o', "3"), Map.entry('n', "4"), Map.entry('r', "0")
+    );
+
+    private TesseraBanner() {
+    }
+
+    @SuppressWarnings("unchecked")
+    public static void print() {
+        if (!Boolean.TRUE.equals(TesseraCompat.value("console.banner.enabled"))) {
+            return;
+        }
+        final Logger logger = LoggerFactory.getLogger(LOGGER_NAME);
+        final boolean ansi = TerminalConsoleAppender.isAnsiSupported();
+        final Map<String, String> placeholders = placeholders();
+        logger.info("");
+        for (final String path : List.of("console.banner.logo", "console.banner.lines")) {
+            for (final String line : (List<String>) TesseraCompat.value(path)) {
+                String text = line;
+                for (final Map.Entry<String, String> placeholder : placeholders.entrySet()) {
+                    text = text.replace(placeholder.getKey(), placeholder.getValue());
+                }
+                logger.info("  {}", colors(text, ansi));
+            }
+        }
+    }
+
+    private static Map<String, String> placeholders() {
+        final ServerBuildInfo build = ServerBuildInfo.buildInfo();
+        final long maxMemory = Runtime.getRuntime().maxMemory();
+        final String memory = maxMemory >= 1L << 30
+            ? String.format(Locale.ROOT, "%.1f GB", maxMemory / (double) (1L << 30))
+            : (maxMemory >> 20) + " MB";
+        return Map.of(
+            "{brand}", build.brandName(),
+            "{version}", build.asString(ServerBuildInfo.StringRepresentation.VERSION_SIMPLE),
+            "{minecraft}", SharedConstants.getCurrentVersion().name(),
+            "{java}", System.getProperty("java.version"),
+            "{os}", System.getProperty("os.name") + " " + System.getProperty("os.arch"),
+            "{cpus}", Integer.toString(Runtime.getRuntime().availableProcessors()),
+            "{memory}", memory
+        );
+    }
+
+    /**
+     * Turns {@code &} color codes into ANSI escapes, or drops them when {@code ansi} is false. A line that used a
+     * code ends with a reset.
+     */
+    static String colors(final String text, final boolean ansi) {
+        final StringBuilder out = new StringBuilder(text.length() + 16);
+        boolean colored = false;
+        for (int i = 0; i < text.length(); ++i) {
+            final char c = text.charAt(i);
+            if (c == '&' && i + 7 < text.length() && text.charAt(i + 1) == '#' && isHex(text, i + 2, 6)) {
+                if (ansi) {
+                    final int rgb = Integer.parseInt(text.substring(i + 2, i + 8), 16);
+                    out.append("\u001B[38;2;").append(rgb >> 16 & 0xFF).append(';').append(rgb >> 8 & 0xFF).append(';').append(rgb & 0xFF).append('m');
+                    colored = true;
+                }
+                i += 7;
+                continue;
+            }
+            if (c == '&' && i + 1 < text.length()) {
+                final String code = CODES.get(Character.toLowerCase(text.charAt(i + 1)));
+                if (code != null) {
+                    if (ansi) {
+                        // a color also ends bold and the like, as in Minecraft
+                        out.append("\u001B[").append(code.length() == 2 && !code.equals("0") ? "0;" + code : code).append('m');
+                        colored = true;
+                    }
+                    ++i;
+                    continue;
+                }
+            }
+            out.append(c);
+        }
+        if (colored) {
+            out.append("\u001B[0m");
+        }
+        return out.toString();
+    }
+
+    private static boolean isHex(final String text, final int start, final int length) {
+        for (int i = start; i < start + length; ++i) {
+            if (Character.digit(text.charAt(i), 16) < 0) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
+// Tessera end - console banner
