             final Boolean ansi = ansiFromEnv(System.getenv());
@@ -35,6 +40,39 @@ public final class TesseraLogStyle {
         }
     }
 
+    // Tessera start - console banner
+    /**
+     * {@code console.style} of {@code tessera.yml}, read before Log4j starts and before the options are parsed; the
+     * settings directory comes from {@code --paper-settings-directory} or {@code --paper-dir} when given.
+     */
+    private static String fromConfig(final String[] args) {
+        String directory = "config";
+        for (int i = 0; i < args.length; ++i) {
+            final String arg = args[i];
+            for (final String name : new String[] {"--paper-settings-directory", "--paper-dir"}) {
+                if (arg.equals(name) && i + 1 < args.length) {
+                    directory = args[i + 1];
+                } else if (arg.startsWith(name + "=")) {
+                    directory = arg.substring(name.length() + 1);
+                }
+            }
+        }
+        final java.nio.file.Path file = java.nio.file.Path.of(directory, "tessera.yml");
+        if (java.nio.file.Files.notExists(file)) {
+            return null;
+        }
+        try (final java.io.Reader reader = java.nio.file.Files.newBufferedReader(file)) {
+            if (new org.yaml.snakeyaml.Yaml().load(reader) instanceof Map<?, ?> root
+                && root.get("console") instanceof Map<?, ?> console && console.get("style") != null) {
+                return console.get("style").toString();
+            }
+        } catch (final java.io.IOException | RuntimeException ex) {
+            // reported when the file is loaded properly
+        }
+        return null;
+    }
+    // Tessera end - console banner
+
     /**
      * Color on or off from the environment for {@code terminal.ansi}, which TerminalConsoleAppender reads: {@code NO_COLOR}
      * (no-color.org) turns it off, {@code FORCE_COLOR} turns it on without a TTY, and so does a Pterodactyl container
@@ -61,7 +99,7 @@ public final class TesseraLogStyle {
             case CLASSIC, PRETTY -> style;
             default -> {
                 // Log4j is not up yet
-                System.err.println("Unknown log style '" + raw + "' in " + PROPERTY + "/" + ENV + ", using " + PRETTY + " (expected " + CLASSIC + " or " + PRETTY + ")");
+                System.err.println("Unknown log style '" + raw + "' in " + PROPERTY + "/" + ENV + "/tessera.yml, using " + PRETTY + " (expected " + CLASSIC + " or " + PRETTY + ")");
                 yield PRETTY;
             }
         };
