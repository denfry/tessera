From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denfry <dabinayo@pm.me>
Date: Tue, 3 Nov 2026 10:53:53 +0300
Subject: [PATCH] Run teleports from onDisable owning the entity's region

At shutdown plugins are disabled on the region shutdown thread, which
passes the ownership check but owns no region. A teleportAsync that
moved the entity to another chunk section failed with a
NullPointerException reading the region's nearby players. Run it owning
the entity's region, like Entity#remove.

diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 26be4bb20caf029c8433bcf09a8b398ade2d0d26..00b828f6d11c4f70a942ecd45a0debcbf3c6b7b5 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1250,6 +1250,12 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         // Tessera start - teleport a joining player on its next tick
         // In PlayerJoinEvent the player is not in the chunk loader and the tracker yet (T-067)
         final boolean joining = this.getHandle() instanceof net.minecraft.server.level.ServerPlayer player && player.suppressTrackerForLogin;
+        // Tessera start - a teleport from onDisable has no region to run on
+        if (io.papermc.paper.threadedregions.TickRegionScheduler.getCurrentRegion() == null
+            && io.papermc.paper.threadedregions.RegionShutdownThread.runOwnedDuringShutdown((net.minecraft.server.level.ServerLevel) this.entity.level(), this.entity.chunkPosition().x(), this.entity.chunkPosition().z(), () -> run.accept(this.getHandle()))) {
+            return ret;
+        }
+        // Tessera end - a teleport from onDisable has no region to run on
         if (org.bukkit.Bukkit.isOwnedByCurrentRegion(this) && !joining) {
         // Tessera end - teleport a joining player on its next tick
             run.accept(this.getHandle());
